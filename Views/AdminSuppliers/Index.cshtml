@model IEnumerable<PPMEnergyWeb.Models.Supplier>
@using PPMEnergyWeb.Models
@{
    ViewData["Title"] = "จัดการซัพพลายเออร์";
    Layout = "_LayoutAdmin";
    var allCategories = (List<Category>)ViewBag.Categories;
}

<div class="space-y-6">
    @* Page Header *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <nav class="flex text-xs font-medium text-gray-400 mb-1 space-x-2">
                <span class="text-gray-600">จัดซื้อ</span>
                <span>/</span>
                <span class="text-gray-600">ซัพพลายเออร์</span>
            </nav>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">ซัพพลายเออร์ (บริษัทที่ PPM ติดต่อรับสินค้า)</h1>
        </div>
        <a asp-action="Create" class="inline-flex items-center justify-center px-4 py-2.5 bg-ppmgreen text-white text-sm font-semibold rounded-xl hover:bg-ppmgreen-dark transition-all shadow-sm shadow-ppmgreen/10">
            <i class="fa-solid fa-plus mr-2 text-xs"></i> เพิ่มซัพพลายเออร์
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-700 text-sm font-semibold flex items-center gap-2">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }

    @* Overview Cards *@
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="bg-white p-5 rounded-2xl border border-gray-200/80 shadow-sm flex items-center space-x-4">
            <div class="w-12 h-12 rounded-xl bg-ppmgreen/10 flex items-center justify-center text-ppmgreen">
                <i class="fa-solid fa-industry text-xl"></i>
            </div>
            <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">ทั้งหมด</p>
                <h3 class="text-2xl font-bold text-gray-900 mt-0.5">@ViewBag.TotalCount <span class="text-sm font-medium text-gray-500">บริษัท</span></h3>
            </div>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-gray-200/80 shadow-sm flex items-center space-x-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                <i class="fa-solid fa-handshake text-xl"></i>
            </div>
            <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">ใช้งานอยู่</p>
                <h3 class="text-2xl font-bold text-gray-900 mt-0.5">@ViewBag.ActiveCount <span class="text-sm font-medium text-gray-500">บริษัท</span></h3>
            </div>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-gray-200/80 shadow-sm flex items-center space-x-4">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-slate-500">
                <i class="fa-solid fa-pause text-xl"></i>
            </div>
            <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">ระงับการติดต่อ</p>
                <h3 class="text-2xl font-bold text-gray-900 mt-0.5">@(((int)ViewBag.TotalCount) - ((int)ViewBag.ActiveCount)) <span class="text-sm font-medium text-gray-500">บริษัท</span></h3>
            </div>
        </div>
    </div>

    @* Filter / Search *@
    <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-5">
        <form method="get" asp-action="Index" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <div class="md:col-span-5">
                <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">ค้นหา</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                        <i class="fa-solid fa-magnifying-glass text-sm"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="ชื่อบริษัท, ผู้ติดต่อ, อีเมล, เบอร์โทร..."
                           class="w-full pl-9 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none transition-all text-gray-700" />
                </div>
            </div>
            <div class="md:col-span-4">
                <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">กรองตามหมวดหมู่สินค้า</label>
                <select name="categoryId" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none transition-all text-gray-700">
                    <option value="">— ทุกหมวดหมู่ —</option>
                    @foreach (var cat in allCategories)
                    {
                        var prefix = cat.ParentCategoryId != null ? "— " : "";
                        <option value="@cat.Id" selected="@(ViewBag.CategoryId == cat.Id)">@prefix@cat.DisplayName</option>
                    }
                </select>
            </div>
            <div class="md:col-span-2 flex items-center gap-2 pb-2.5">
                <input type="checkbox" name="activeOnly" value="true" id="activeOnly" @(ViewBag.ActiveOnly == true ? "checked" : "")
                       class="w-4 h-4 rounded border-gray-300 text-ppmgreen focus:ring-ppmgreen/30" />
                <label for="activeOnly" class="text-sm font-semibold text-gray-600">เฉพาะที่ใช้งานอยู่</label>
            </div>
            <div class="md:col-span-1">
                <button type="submit" class="w-full py-2.5 bg-ppmgreen text-white rounded-xl text-sm font-bold hover:bg-ppmgreen-dark transition-all">
                    <i class="fa-solid fa-filter"></i>
                </button>
            </div>
        </form>
    </div>

    @* Table *@
    <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-600">
                <thead class="bg-gray-50 text-gray-500 uppercase text-[11px] font-bold tracking-wider border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-3.5">บริษัท</th>
                        <th class="px-6 py-3.5">ช่องทางติดต่อ</th>
                        <th class="px-6 py-3.5">หมวดหมู่สินค้าที่รับ</th>
                        <th class="px-6 py-3.5 text-center">สถานะ</th>
                        <th class="px-6 py-3.5 text-right">เครื่องมือ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-16 text-center">
                                <div class="max-w-xs mx-auto text-gray-400 space-y-2">
                                    <i class="fa-solid fa-industry text-4xl text-gray-300"></i>
                                    <p class="font-medium text-sm">ยังไม่มีข้อมูลซัพพลายเออร์ในระบบ</p>
                                    <p class="text-xs text-gray-400">เริ่มเพิ่มบริษัทซัพพลายเออร์แรกได้โดยคลิกปุ่มด้านบน</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var s in Model)
                    {
                        <tr class="hover:bg-gray-50/70 transition-colors">
                            <td class="px-6 py-4">
                                <p class="font-bold text-gray-900">@s.CompanyName</p>
                                @if (!string.IsNullOrEmpty(s.ContactPersonName))
                                {
                                    <p class="text-xs text-gray-400 mt-0.5"><i class="fa-solid fa-user text-[10px] mr-1"></i>@s.ContactPersonName</p>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="space-y-1 text-xs">
                                    @if (!string.IsNullOrEmpty(s.Phone))
                                    {
                                        <p class="text-gray-600"><i class="fa-solid fa-phone text-[10px] w-4 text-gray-400"></i> @s.Phone</p>
                                    }
                                    @if (!string.IsNullOrEmpty(s.Email))
                                    {
                                        <p class="text-gray-600"><i class="fa-solid fa-envelope text-[10px] w-4 text-gray-400"></i> @s.Email</p>
                                    }
                                    @if (!string.IsNullOrEmpty(s.LineId))
                                    {
                                        <p class="text-gray-600"><i class="fa-brands fa-line text-[10px] w-4 text-gray-400"></i> @s.LineId</p>
                                    }
                                    @if (string.IsNullOrEmpty(s.Phone) && string.IsNullOrEmpty(s.Email) && string.IsNullOrEmpty(s.LineId))
                                    {
                                        <span class="text-gray-300">ไม่ได้ระบุ</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-wrap gap-1 max-w-xs">
                                    @if (!s.SupplierCategories.Any())
                                    {
                                        <span class="text-xs text-gray-300">ไม่ได้ระบุ</span>
                                    }
                                    @foreach (var sc in s.SupplierCategories)
                                    {
                                        <span class="text-[10px] bg-blue-50 text-blue-600 border border-blue-200 font-bold px-2 py-0.5 rounded-full">@sc.Category.DisplayName</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (s.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> ใช้งานอยู่
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-gray-100 text-gray-500 border border-gray-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span> ระงับ
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right space-x-1.5 whitespace-nowrap">
                                <a asp-action="Edit" asp-route-id="@s.Id"
                                   class="inline-flex items-center px-3 py-1.5 bg-white text-blue-600 hover:bg-blue-50 border border-blue-200 hover:border-blue-300 rounded-lg text-xs font-semibold transition-all">
                                    <i class="fa-solid fa-pen mr-1.5"></i> แก้ไข
                                </a>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="inline-block"
                                      onsubmit="return confirm('ลบซัพพลายเออร์: @s.CompanyName ?\nไม่สามารถกู้คืนได้');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="inline-flex items-center px-3 py-1.5 bg-white text-red-600 hover:bg-red-50 border border-red-200 hover:border-red-300 rounded-lg text-xs font-semibold transition-all">
                                        <i class="fa-solid fa-trash-can mr-1.5"></i> ลบ
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
