@model PPMEnergyWeb.Models.Quote
@using PPMEnergyWeb.Models
@{
    ViewData["Title"] = "ตะกร้าสินค้า / ขอใบเสนอราคา";
    var cart = (List<CartItem>)ViewBag.Cart;
}

<div class="min-h-screen bg-gray-50/50 py-12">
    <div class="max-w-6xl mx-auto px-4">

        <div class="mb-8">
            <a asp-controller="Products" asp-action="Index" class="inline-flex items-center text-sm font-bold text-gray-400 hover:text-[#009933] transition-all group">
                <i class="fa-solid fa-arrow-left-long mr-2 group-hover:-translate-x-1 transition-transform"></i>
                เลือกสินค้าเพิ่มเติม
            </a>
            <h1 class="text-2xl font-black text-gray-900 mt-3 flex items-center gap-2">
                <i class="fa-solid fa-cart-shopping text-[#009933]"></i> ตะกร้าสินค้าของคุณ
            </h1>
            <p class="text-sm text-gray-500 mt-1">เลือกสินค้าได้หลายรายการ แล้วส่งเป็นใบขอเสนอราคาใบเดียว</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm font-semibold flex items-center gap-2">
                <i class="fa-solid fa-circle-exclamation"></i> @TempData["ErrorMessage"]
            </div>
        }

        @if (cart == null || !cart.Any())
        {
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-16 text-center">
                <i class="fa-solid fa-cart-shopping text-5xl text-gray-200 mb-4"></i>
                <p class="text-gray-500 font-semibold">ตะกร้าของคุณยังว่างอยู่</p>
                <a asp-controller="Products" asp-action="Index" class="inline-flex items-center gap-2 mt-4 px-5 py-2.5 bg-[#009933] text-white rounded-xl font-bold text-sm hover:bg-green-700 transition-all">
                    <i class="fa-solid fa-magnifying-glass"></i> เลือกดูสินค้า
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

                @* ── รายการสินค้าในตะกร้า ── *@
                <div class="lg:col-span-7 space-y-3">
                    @foreach (var item in cart)
                    {
                        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 flex items-center gap-4">
                            <img src="@(item.ImageUrl ?? "/images/placeholder.png")" class="w-16 h-16 rounded-xl object-cover border border-gray-100 shrink-0" alt="@item.ProductName" />
                            <div class="flex-1 min-w-0">
                                <p class="font-bold text-gray-800 text-sm truncate">@item.ProductName</p>
                                <form asp-controller="Cart" asp-action="UpdateQty" method="post" class="flex items-center gap-2 mt-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <label class="text-[11px] text-gray-400 font-bold uppercase">จำนวน</label>
                                    <input type="number" name="qty" value="@item.Quantity" min="1"
                                           class="w-20 px-2 py-1 text-sm bg-gray-50 border border-gray-200 rounded-lg font-bold text-gray-700 focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none" />
                                    <button type="submit" class="text-xs font-bold text-[#009933] hover:underline">อัปเดต</button>
                                </form>
                            </div>
                            <form asp-controller="Cart" asp-action="Remove" method="post"
                                  onsubmit="return confirm('เอา &quot;@item.ProductName&quot; ออกจากตะกร้าใช่ไหม?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="w-9 h-9 flex items-center justify-center rounded-xl bg-red-50 hover:bg-red-100 text-red-500 transition-colors shrink-0">
                                    <i class="fa-solid fa-trash-can text-sm"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>

                @* ── ฟอร์มข้อมูลผู้ติดต่อ + ปุ่มส่ง ── *@
                <div class="lg:col-span-5">
                    <form asp-controller="Cart" asp-action="Checkout" method="post" class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-4 sticky top-24">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs font-semibold"></div>

                        <h3 class="text-sm font-bold text-gray-800 flex items-center gap-2 border-b border-gray-50 pb-3">
                            <i class="fa-solid fa-address-card text-[#009933]"></i> ข้อมูลผู้ติดต่อ
                        </h3>

                        <div>
                            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1">ชื่อบริษัท / องค์กร <span class="text-red-500">*</span></label>
                            <input asp-for="CompanyName" required placeholder="ระบุชื่อบริษัทเต็มของคุณ"
                                   class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none font-semibold text-gray-800 text-sm" />
                        </div>

                        <div>
                            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1">ชื่อผู้ติดต่อ <span class="text-red-500">*</span></label>
                            <input asp-for="ContactName" required placeholder="ชื่อ - นามสกุล"
                                   class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none font-semibold text-gray-800 text-sm" />
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1">อีเมล <span class="text-red-500">*</span></label>
                                <input asp-for="Email" type="email" required
                                       class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none font-semibold text-gray-800 text-sm" />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1">เบอร์โทร <span class="text-red-500">*</span></label>
                                <input asp-for="Phone" required placeholder="08X-XXX-XXXX"
                                       class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none font-semibold text-gray-800 text-sm" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1">สถานที่จัดส่ง <span class="text-red-500">*</span></label>
                            <input asp-for="DeliveryLocation" required placeholder="เช่น นิคมอุตสาหกรรมมาบตาพุด จ.ระยอง"
                                   class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none font-semibold text-gray-800 text-sm" />
                        </div>

                        <div>
                            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1">หมายเหตุ / สเปคเพิ่มเติม (ถ้ามี)</label>
                            <textarea asp-for="Note" rows="2" placeholder="ระบุรายละเอียดเพิ่มเติมที่ต้องการให้ทีมงานทราบ..."
                                      class="w-full p-3 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none font-semibold text-gray-800 text-sm resize-none"></textarea>
                        </div>

                        <button type="submit"
                                class="w-full py-3 bg-[#009933] hover:bg-green-700 text-white rounded-xl font-bold transition-all shadow-lg shadow-green-500/20 flex items-center justify-center gap-2 text-sm">
                            <i class="fa-solid fa-paper-plane"></i> ส่งขอใบเสนอราคา (@cart.Count รายการ)
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
