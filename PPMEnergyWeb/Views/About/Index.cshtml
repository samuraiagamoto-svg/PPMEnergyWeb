        background-size: 32px 32px;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(110, 123, 107, 0.1);
    }

    .industrial-glow {
        box-shadow: 0 0 20px rgba(0, 153, 51, 0.15);
    }
</style>

