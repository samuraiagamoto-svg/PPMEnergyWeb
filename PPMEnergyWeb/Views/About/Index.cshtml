<script>
    // ==========================================
    // Slider Logic (สำหรับ Unit 01)
    // ==========================================
    let currentSlide = 0;
    const totalSlides = 3;

    function updateSlider() {
        const slider = document.getElementById('slider-1');
        if(slider) {
            slider.style.transform = `translateX(-${currentSlide * 100}%)`;

            for(let i = 0; i < totalSlides; i++) {
                const dot = document.getElementById(`dot-${i}`);
                if(dot) {
                    if(i === currentSlide) {
                        dot.classList.remove('bg-white/40');
                        dot.classList.add('bg-white');
                    } else {
                        dot.classList.remove('bg-white');
                        dot.classList.add('bg-white/40');
                    }
                }
            }
        }
    }

    function nextSlide() {
        currentSlide = (currentSlide + 1) % totalSlides;
        updateSlider();
    }

    function prevSlide() {
        currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
        updateSlider();
    }

    function goToSlide(index) {
        currentSlide = index;
        updateSlider();
    }

    // เลื่อนรูปอัตโนมัติทุกๆ 5 วินาที
    setInterval(nextSlide, 5000);

        // ==========================================
    // Slider Logic (สำหรับ Unit 02 - Heavy Machinery)
    // ==========================================
    let currentSlide2 = 0;
    const totalSlides2 = 6; // มีรูปทั้งหมด 6 รูป

    function updateSlider2() {
        const slider = document.getElementById('slider-2');
        if(slider) {
            slider.style.transform = `translateX(-${currentSlide2 * 100}%)`;

            for(let i = 0; i < totalSlides2; i++) {
                const dot = document.getElementById(`dot2-${i}`);
                if(dot) {
                    if(i === currentSlide2) {
                        dot.classList.remove('bg-white/60');
                        dot.classList.add('bg-primary');
                    } else {
                        dot.classList.remove('bg-primary');
                        dot.classList.add('bg-white/60');
                    }
                }
            }
        }
    }

    function nextSlide2() {
        currentSlide2 = (currentSlide2 + 1) % totalSlides2;
        updateSlider2();
    }

    function prevSlide2() {
        currentSlide2 = (currentSlide2 - 1 + totalSlides2) % totalSlides2;
        updateSlider2();
    }

    function goToSlide2(index) {
        currentSlide2 = index;
        updateSlider2();
    }

    // ตั้งเวลาให้สไลด์ที่ 2 เลื่อนอัตโนมัติ (ตั้งไว้ที่ 6 วินาที เพื่อไม่ให้สไลด์พร้อมกับตัวแรก)
    setInterval(nextSlide2, 6000);

        // ==========================================
    // Slider Logic (สำหรับ Unit 03 - Factory Machinery)
    // ==========================================
    let currentSlide3 = 0;
    const totalSlides3 = 3; // จำนวนรูปภาพในสไลเดอร์ที่ 3 (ปรับแก้ตามจำนวนรูปจริง)

    function updateSlider3() {
        const slider = document.getElementById('slider-3');
        if(slider) {
            // เลื่อนรูปภาพ
            slider.style.transform = `translateX(-${currentSlide3 * 100}%)`;

            // อัปเดตสถานะของจุด (Dots)
            for(let i = 0; i < totalSlides3; i++) {
                const dot = document.getElementById(`dot3-${i}`);
                if(dot) {
                    if(i === currentSlide3) {
                        dot.classList.remove('bg-white/60');
                        dot.classList.add('bg-primary');
                    } else {
                        dot.classList.remove('bg-primary');
                        dot.classList.add('bg-white/60');
                    }
                }
            }
        }
    }

    function nextSlide3() {
        currentSlide3 = (currentSlide3 + 1) % totalSlides3;
        updateSlider3();
    }

    function prevSlide3() {
        currentSlide3 = (currentSlide3 - 1 + totalSlides3) % totalSlides3;
        updateSlider3();
    }

    function goToSlide3(index) {
        currentSlide3 = index;
        updateSlider3();
    }

    // ตั้งเวลาให้สไลด์ที่ 3 เลื่อนอัตโนมัติ ทุกๆ 7 วินาที
    // (ตั้งเวลาเหลื่อมกับสไลด์อื่นเล็กน้อย เพื่อให้หน้าเว็บดูมีความเคลื่อนไหวแบบเป็นธรรมชาติ)
    setInterval(nextSlide3, 7000);

        // ==========================================
    // Slider Logic (สำหรับ Unit 04 - Infrastructure)
    // ==========================================
    let currentSlide4 = 0;
    const totalSlides4 = 3; // กำหนดจำนวนรูปเป็น 2

    function updateSlider4() {
        const slider = document.getElementById('slider-4');
        if(slider) {
            slider.style.transform = `translateX(-${currentSlide4 * 100}%)`;

            for(let i = 0; i < totalSlides4; i++) {
                const dot = document.getElementById(`dot4-${i}`);
                if(dot) {
                    if(i === currentSlide4) {
                        dot.classList.remove('bg-white/60');
                        dot.classList.add('bg-primary');
                    } else {
                        dot.classList.remove('bg-primary');
                        dot.classList.add('bg-white/60');
                    }
                }
            }
        }
    }

    function nextSlide4() {
        currentSlide4 = (currentSlide4 + 1) % totalSlides4;
        updateSlider4();
    }

    function prevSlide4() {
        currentSlide4 = (currentSlide4 - 1 + totalSlides4) % totalSlides4;
        updateSlider4();
    }

    function goToSlide4(index) {
        currentSlide4 = index;
        updateSlider4();
    }

    // ตั้งเวลาให้สไลด์ที่ 4 เลื่อนอัตโนมัติ ทุกๆ 8 วินาที
    // (ตั้งเวลาไม่ให้ซ้ำกับตัวอื่น 6s, 7s, 8s จะทำให้หน้าเว็บดูเลื่อนแบบสุ่มเป็นธรรมชาติ)
    setInterval(nextSlide4, 8000);

    // ==========================================
    // Intersection Observer (Animation การเลื่อนหน้าเว็บ)
    // ==========================================
    document.addEventListener("DOMContentLoaded", function() {
        const observerOptions = {
            threshold: 0.1,
            rootMargin: "0px 0px -50px 0px"
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('opacity-100', 'translate-y-0');
                    entry.target.classList.remove('opacity-0', 'translate-y-10');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('section > div').forEach(el => {
            el.classList.add('transition-all', 'duration-1000', 'opacity-0', 'translate-y-10');
            observer.observe(el);
        });
    });
</script>