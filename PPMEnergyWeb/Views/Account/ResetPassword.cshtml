@model PPMEnergyWeb.Models.AccountViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "ตั้งรหัสผ่านใหม่";
}

<div class="min-h-[70vh] flex items-center justify-center bg-gray-50 py-12 px-4">
    <div class="w-full max-w-md bg-white rounded-3xl border border-gray-100 shadow-xl p-8">

        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-ppmgreen/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-lock text-ppmgreen text-2xl"></i>
            </div>
            <h1 class="text-2xl font-black text-gray-900">ตั้งรหัสผ่านใหม่</h1>
            <p class="text-gray-500 text-sm mt-2">กรอกรหัสผ่านใหม่ที่ต้องการใช้งาน</p>
        </div>

        <form asp-action="ResetPassword" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input asp-for="Code" type="hidden" />
            <input asp-for="Email" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <div class="space-y-1.5">
                <label asp-for="Password" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">รหัสผ่านใหม่</label>
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input asp-for="Password" type="password" placeholder="อย่างน้อย 6 ตัวอักษร"
                           class="w-full pl-11 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm
                                  focus:outline-none focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen focus:bg-white transition-all" />
                </div>
                <span asp-validation-for="Password" class="text-xs font-semibold text-red-500"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="ConfirmPassword" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">ยืนยันรหัสผ่านใหม่</label>
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input asp-for="ConfirmPassword" type="password" placeholder="กรอกรหัสผ่านอีกครั้ง"
                           class="w-full pl-11 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm
                                  focus:outline-none focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen focus:bg-white transition-all" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-xs font-semibold text-red-500"></span>
            </div>

            <button type="submit"
                    class="w-full py-3 bg-ppmgreen text-white font-bold rounded-xl hover:bg-ppmgreen-dark transition-colors shadow-sm shadow-ppmgreen/20">
                บันทึกรหัสผ่านใหม่
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
