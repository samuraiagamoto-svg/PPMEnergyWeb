@{
    ViewData["Title"] = "ส่งอีเมลแล้ว";
}

<div class="min-h-[70vh] flex items-center justify-center bg-gray-50 py-12 px-4">
    <div class="w-full max-w-md bg-white rounded-3xl border border-gray-100 shadow-xl p-8 text-center">

        <div class="w-16 h-16 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-paper-plane text-ppmgreen text-2xl"></i>
        </div>

        <h1 class="text-2xl font-black text-gray-900 mb-3">ตรวจสอบอีเมลของคุณ</h1>
        <p class="text-gray-500 text-sm leading-relaxed">
            หากอีเมลนี้มีอยู่ในระบบ เราได้ส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ไปให้แล้ว
            กรุณาตรวจสอบกล่องจดหมาย (รวมถึงโฟลเดอร์สแปม) ลิงก์จะหมดอายุภายใน 1 ชั่วโมง
        </p>

        <a asp-action="Login"
           class="inline-block mt-6 px-6 py-3 bg-ppmgreen text-white font-bold rounded-xl hover:bg-ppmgreen-dark transition-colors">
            กลับไปหน้าเข้าสู่ระบบ
        </a>
    </div>
</div>
