@{
    ViewData["Title"] = "ตั้งรหัสผ่านสำเร็จ";
}

<div class="min-h-[70vh] flex items-center justify-center bg-gray-50 py-12 px-4">
    <div class="w-full max-w-md bg-white rounded-3xl border border-gray-100 shadow-xl p-8 text-center">

        <div class="w-16 h-16 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-circle-check text-ppmgreen text-3xl"></i>
        </div>

        <h1 class="text-2xl font-black text-gray-900 mb-3">เปลี่ยนรหัสผ่านสำเร็จ</h1>
        <p class="text-gray-500 text-sm leading-relaxed">
            รหัสผ่านของคุณถูกเปลี่ยนเรียบร้อยแล้ว สามารถเข้าสู่ระบบด้วยรหัสผ่านใหม่ได้ทันที
        </p>

        <a asp-action="Login"
           class="inline-block mt-6 px-6 py-3 bg-ppmgreen text-white font-bold rounded-xl hover:bg-ppmgreen-dark transition-colors">
            เข้าสู่ระบบ
        </a>
    </div>
</div>
