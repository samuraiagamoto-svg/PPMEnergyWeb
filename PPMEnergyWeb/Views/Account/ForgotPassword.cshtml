@model PPMEnergyWeb.Models.AccountViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "ลืมรหัสผ่าน";
}

<div class="min-h-[70vh] flex items-center justify-center bg-gray-50 py-12 px-4">
    <div class="w-full max-w-md bg-white rounded-3xl border border-gray-100 shadow-xl p-8">

        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-ppmgreen/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-key text-ppmgreen text-2xl"></i>
            </div>
            <h1 class="text-2xl font-black text-gray-900">ลืมรหัสผ่าน?</h1>
            <p class="text-gray-500 text-sm mt-2">กรอกอีเมลที่ใช้สมัครสมาชิก เราจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ให้คุณ</p>
        </div>

        <form asp-action="ForgotPassword" method="post" class="space-y-5">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <div class="space-y-1.5">
                <label asp-for="Email" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">อีเมล</label>
                <div class="relative">
                    <i class="fa-solid fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input asp-for="Email" type="email" placeholder="you@example.com"
                           class="w-full pl-11 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm
                                  focus:outline-none focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen focus:bg-white transition-all" />
                </div>
                <span asp-validation-for="Email" class="text-xs font-semibold text-red-500"></span>
            </div>

            <button type="submit"
                    class="w-full py-3 bg-ppmgreen text-white font-bold rounded-xl hover:bg-ppmgreen-dark transition-colors shadow-sm shadow-ppmgreen/20">
                ส่งลิงก์รีเซ็ตรหัสผ่าน
            </button>

            <div class="text-center">
                <a asp-action="Login" class="text-sm text-gray-500 hover:text-ppmgreen transition-colors">
                    <i class="fa-solid fa-arrow-left mr-1"></i> กลับไปหน้าเข้าสู่ระบบ
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
