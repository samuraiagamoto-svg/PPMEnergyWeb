@model PPMEnergyWeb.Models.Category

@{
    ViewData["Title"] = "แก้ไขหมวดหมู่สินค้า";
    Layout = "_LayoutAdmin";

    // ตรวจว่าตอนนี้เป็น Sub Category หรือไม่
    bool isSub = Model.ParentCategoryId.HasValue;
}

<div class="space-y-6 max-w-5xl mx-auto">
    @* Top Actions Bar *@
    <div class="flex items-center justify-between">
        <a asp-action="Index" class="inline-flex items-center text-sm font-semibold text-gray-500 hover:text-ppmgreen transition-colors">
            <i class="fa-solid fa-arrow-left mr-2 text-xs"></i> ย้อนกลับไปหน้าตาราง
        </a>
    </div>

    @* Split Layout Box *@
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

        @* Left Caution Card *@
        <div class="space-y-4">
            <div class="bg-amber-50/60 p-6 rounded-2xl border border-amber-200">
                <h3 class="text-sm font-bold text-amber-900 flex items-center">
                    <i class="fa-solid fa-triangle-exclamation text-amber-600 mr-2"></i> ข้อควรระวังในการแก้ไข
                </h3>
                <p class="text-xs text-amber-800 mt-2 leading-relaxed">
                    การเปลี่ยน <strong class="text-amber-950">"รหัสหมวดหมู่ (URL Slug)"</strong> จะส่งผลให้เส้นทางลิงก์ของหน้านั้นเปลี่ยนไปทันที หากลิงก์เดิมเคยถูกแชร์หรือบันทึกไว้ใน Google อาจทำให้ลูกค้าเจอหน้า 404 ชั่วคราว
                </p>
            </div>

            @* โครงสร้างปัจจุบัน *@
            <div class="bg-white p-5 rounded-2xl border border-gray-200/80 shadow-sm">
                <h4 class="text-xs font-bold text-gray-700 mb-3 flex items-center uppercase tracking-wider">
                    <i class="fa-solid fa-info-circle text-ppmgreen mr-2"></i> ข้อมูลปัจจุบัน
                </h4>
                <div class="space-y-2 text-xs">
                    <div class="flex items-center justify-between">
                        <span class="text-gray-500">ID</span>
                        <span class="font-mono font-bold text-gray-800 bg-gray-100 px-2 py-0.5 rounded">#@Model.Id</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-gray-500">ประเภท</span>
                        @if (isSub)
                        {
                            <span class="text-[10px] bg-blue-50 text-blue-600 border border-blue-200 font-bold px-2 py-0.5 rounded-full">
                                <i class="fa-solid fa-folder-open mr-1"></i>Sub Category
                            </span>
                        }
                        else
                        {
                            <span class="text-[10px] bg-ppmgreen/10 text-ppmgreen border border-ppmgreen/20 font-bold px-2 py-0.5 rounded-full">
                                <i class="fa-solid fa-folder mr-1"></i>Main Category
                            </span>
                        }
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-gray-500">URL Slug</span>
                        <span class="font-mono text-slate-600 text-[10px]">@Model.CategoryCode</span>
                    </div>
                </div>
            </div>
        </div>

        @* Right Form Box *@
        <div class="lg:col-span-2 bg-white border border-gray-200/80 shadow-sm rounded-2xl overflow-hidden">
            <div class="p-6 border-b border-gray-100 bg-gray-50/30">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-lg font-bold text-gray-900">ฟอร์มแก้ไขข้อมูลหมวดหมู่</h2>
                        <p class="text-xs text-gray-500">ทำการอัปเดตข้อมูลล่าสุดของหมวดหมู่นี้ในระบบ</p>
                    </div>
                    <span class="text-[10px] bg-slate-100 border border-slate-200 text-slate-600 font-bold px-2 py-1 rounded-md font-mono">ID: @Model.Id</span>
                </div>
            </div>

            @* 🛠️ ปรับปรุงจุดที่ 1: เติม enctype="multipart/form-data" เพื่อให้แบบฟอร์ม Edit ส่งไฟล์ภาพไปที่หลังบ้านได้ *@
            <form asp-action="Edit" enctype="multipart/form-data" class="p-6 space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                @* 🛠️ ปรับปรุงจุดที่ 2: ถือค่าลิงก์รูปเก่าติดตัวไปด้วย กรณีผู้ใช้ต้องการแก้ไขข้อมูลอื่นแต่ไม่ได้เปลี่ยนรูปภาพใหม่ *@
                <input type="hidden" asp-for="ImageUrl" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="p-4 bg-red-50 border border-red-200 rounded-xl text-xs text-red-700 flex items-start space-x-2">
                        <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
                        <div asp-validation-summary="All" class="font-medium"></div>
                    </div>
                }

                @* ── Toggle ประเภทหมวดหมู่ ── *@
                <div class="space-y-3">
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider">ประเภทหมวดหมู่</label>
                    <div class="flex rounded-xl border border-gray-200 overflow-hidden">
                        <button type="button" id="btnMain"
                                onclick="setCategoryType('main')"
                                class="flex-1 py-2.5 text-sm font-semibold flex items-center justify-center space-x-2 transition-all @(!isSub ? "bg-ppmgreen text-white" : "bg-white text-gray-500 hover:bg-gray-50")">
                            <i class="fa-solid fa-folder"></i>
                            <span>หมวดหมู่หลัก (Main)</span>
                        </button>
                        <button type="button" id="btnSub"
                                onclick="setCategoryType('sub')"
                                class="flex-1 py-2.5 text-sm font-semibold flex items-center justify-center space-x-2 transition-all @(isSub ? "bg-ppmgreen text-white" : "bg-white text-gray-500 hover:bg-gray-50")">
                            <i class="fa-solid fa-folder-open"></i>
                            <span>หมวดหมู่ย่อย (Sub)</span>
                        </button>
                    </div>
                </div>

                @* ── Dropdown เลือก Parent ── *@
                <div id="parentSection" class="space-y-1.5 @(!isSub ? "hidden" : "")">
                    <label asp-for="ParentCategoryId" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
                        หมวดหมู่หลักที่สังกัด <span class="text-red-500">*</span>
                    </label>
                    <select asp-for="ParentCategoryId"
                            asp-items="ViewBag.ParentCategories"
                            id="parentCategorySelect"
                            class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-800 focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none transition-all">
                        <option value="">— เลือกหมวดหมู่หลัก —</option>
                    </select>
                    <span asp-validation-for="ParentCategoryId" class="text-xs font-semibold text-red-500"></span>
                </div>

                @* ── ชื่อหมวดหมู่ ── *@
                <div class="space-y-1.5">
                    <label asp-for="DisplayName" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
                        ชื่อหมวดหมู่สินค้า <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="DisplayName" id="displayName"
                           class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none transition-all font-semibold text-gray-800"
                           placeholder="ระบุชื่อหมวดหมู่สินค้า" required />
                    <span asp-validation-for="DisplayName" class="text-xs font-semibold text-red-500"></span>
                </div>

                @* 🛠️ ปรับปรุงจุดที่ 3: เปลี่ยนมาใช้ช่องอัปโหลดรูปภาพ พร้อมทำกล่องพรีวิวแสดงภาพปัจจุบันที่ใช้อยู่ *@
                <div class="space-y-2.5">
                    <label asp-for="ImageFile" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
                        รูปภาพหมวดหมู่สินค้า
                    </label>

                    @* ถ้าในฐานข้อมูลมี Path รูปเก่าอยู่แล้ว ให้แสดงตัวอย่างรูปเดิมตรงนี้ *@
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="p-3 bg-gray-50 border border-gray-100 rounded-xl inline-block">
                            <p class="text-[10px] font-bold text-gray-400 uppercase mb-1.5">รูปภาพปัจจุบัน:</p>
                            <img src="@Model.ImageUrl" class="h-28 w-auto rounded-lg border border-gray-200 object-cover shadow-sm" alt="Category Image" />
                        </div>
                    }

                    <input asp-for="ImageFile" type="file" accept="image/*"
                           class="w-full px-4 py-2 bg-white border border-gray-200 rounded-xl text-sm file:mr-4 file:py-1.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-ppmgreen/10 file:text-ppmgreen hover:file:bg-ppmgreen/20 outline-none transition-all" />
                    <span asp-validation-for="ImageFile" class="text-xs font-semibold text-red-500"></span>
                    <p class="text-[11px] text-gray-400">
                        <i class="fa-solid fa-info-circle mr-1 text-ppmgreen"></i>
                        เว้นว่างไว้หากต้องการใช้รูปภาพเดิม หรือเลือกไฟล์รูปใหม่เพื่ออัปโหลดเปลี่ยนแทนที่รูปภาพเดิม
                    </p>
                </div>

                @* ── URL Slug ── *@
                <div class="space-y-1.5">
                    <label asp-for="CategoryCode" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
                        รหัสหมวดหมู่ (URL Slug) <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-xs font-medium text-gray-400 bg-gray-50 border-r border-gray-200 rounded-l-xl px-3">
                            ppm-energy.com/category/
                        </span>
                        <input asp-for="CategoryCode" id="categoryCode"
                               class="w-full pl-[175px] pr-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-mono font-bold text-gray-600 focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none transition-all"
                               placeholder="ระบุรหัส URL" required />
                    </div>
                    <span asp-validation-for="CategoryCode" class="text-xs font-semibold text-red-500"></span>
                </div>

                <input type="hidden" asp-for="DisplayOrder" />

                <div class="pt-4 border-t border-gray-100 flex items-center justify-end space-x-3">
                    <a asp-action="Index" class="px-4 py-2.5 border border-gray-200 text-gray-700 hover:bg-gray-50 text-sm font-semibold rounded-xl transition-colors">
                        ยกเลิกการแก้ไข
                    </a>
                    <button type="submit" class="px-5 py-2.5 bg-ppmgreen text-white hover:bg-ppmgreen-dark text-sm font-bold rounded-xl transition-colors shadow-sm shadow-ppmgreen/10">
                        <i class="fa-solid fa-square-check mr-2"></i> อัปเดตข้อมูลเรียบร้อย
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setCategoryType(type) {
            const parentSection = document.getElementById('parentSection');
            const parentSelect  = document.getElementById('parentCategorySelect');
            const btnMain = document.getElementById('btnMain');
            const btnSub  = document.getElementById('btnSub');

            if (type === 'main') {
                parentSection.classList.add('hidden');
                parentSelect.value = '';
                parentSelect.removeAttribute('required');

                btnMain.classList.add('bg-ppmgreen', 'text-white');
                btnMain.classList.remove('bg-white', 'text-gray-500', 'hover:bg-gray-50');
                btnSub.classList.remove('bg-ppmgreen', 'text-white');
                btnSub.classList.add('bg-white', 'text-gray-500', 'hover:bg-gray-50');
            } else {
                parentSection.classList.remove('hidden');
                parentSelect.setAttribute('required', 'required');

                btnSub.classList.add('bg-ppmgreen', 'text-white');
                btnSub.classList.remove('bg-white', 'text-gray-500', 'hover:bg-gray-50');
                btnMain.classList.remove('bg-ppmgreen', 'text-white');
                btnMain.classList.add('bg-white', 'text-gray-500', 'hover:bg-gray-50');
            }
        }

        // ─── ตั้งค่า required ตอน page load (กรณีเปิดมาแล้วเป็น Sub อยู่แล้ว) ───
        document.addEventListener('DOMContentLoaded', function () {
            var isSub = @(isSub ? "true" : "false");
            if (isSub) {
                document.getElementById('parentCategorySelect').setAttribute('required', 'required');
            }
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}