@model PPMEnergyWeb.Models.Product
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = Model.Name;
}

<div class="min-h-screen bg-gray-50/50 py-12">
    <div class="max-w-7xl mx-auto px-4">

        <div class="mb-8 flex items-center justify-between">
            <a asp-controller="Products" asp-action="Index" class="inline-flex items-center text-sm font-bold text-gray-400 hover:text-[#009933] transition-all group">
                <i class="fa-solid fa-arrow-left-long mr-2 group-hover:-translate-x-1 transition-transform"></i>
                กลับไปหน้ารวมสินค้า
            </a>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="animate-bounce bg-green-500 text-white px-4 py-1.5 rounded-full text-xs font-bold shadow-lg shadow-green-200">
                    <i class="fa-solid fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
                </div>
            }
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-12">

            <div class="lg:col-span-5">
                <div class="sticky top-24">
                    <div class="relative group">
                        <div class="absolute -inset-1 bg-gradient-to-r from-[#009933]/20 to-emerald-400/20 rounded-[2.6rem] blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
                        <div class="relative rounded-[2.5rem] overflow-hidden shadow-2xl shadow-gray-200 border border-white bg-white p-2">
                            <img src="@Model.ImageUrl" class="w-full h-auto rounded-[2rem] object-cover" alt="@Model.Name">
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-4 mt-6">
                        <div class="bg-white p-4 rounded-2xl border border-gray-100 text-center shadow-sm hover:shadow-md transition-shadow">
                            <i class="fa-solid fa-shield-halved text-[#009933] mb-2 block text-xl"></i>
                            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-tighter">Certified Quality</span>
                        </div>
                        <div class="bg-white p-4 rounded-2xl border border-gray-100 text-center shadow-sm hover:shadow-md transition-shadow">
                            <i class="fa-solid fa-truck-fast text-[#009933] mb-2 block text-xl"></i>
                            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-tighter">Global Logistics</span>
                        </div>
                        <div class="bg-white p-4 rounded-2xl border border-gray-100 text-center shadow-sm hover:shadow-md transition-shadow">
                            <i class="fa-solid fa-headset text-[#009933] mb-2 block text-xl"></i>
                            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-tighter">Expert Support</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-7 space-y-10">
                <div>
                    <span class="inline-flex items-center gap-2 bg-[#009933]/10 text-[#009933] px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider mb-4 border border-[#009933]/20">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#009933] animate-pulse"></span>
                        @Model.Category?.DisplayName
                    </span>

                    <h1 class="text-4xl md:text-5xl font-black text-gray-900 leading-[1.1] mb-6 tracking-tight">
                        @Model.Name
                    </h1>

                    <div class="relative">
                        <p class="text-xl text-gray-500 leading-relaxed italic border-l-4 border-[#009933] pl-6 py-2">
                            @Model.Description
                        </p>
                    </div>
                </div>

                @if (Model.Attributes != null && Model.Attributes.Any())
                {
                    <div class="bg-white rounded-[2rem] border border-gray-100 shadow-sm overflow-hidden animate-fadeIn">
                        <div class="bg-gray-50/50 px-8 py-5 border-b flex items-center justify-between">
                            <h2 class="font-bold text-gray-800 flex items-center gap-2">
                                <i class="fa-solid fa-microchip text-[#009933]"></i> ข้อมูลทางเทคนิค
                            </h2>
                            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em]">Specifications</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <tbody>
                                    @foreach (var attr in Model.Attributes)
                                    {
                                        <tr class="border-b last:border-0 hover:bg-gray-50/50 transition-colors">
                                            <td class="px-8 py-4 text-sm font-bold text-gray-500 bg-gray-50/30 w-1/3">@attr.AttributeName</td>
                                            <td class="px-8 py-4 text-sm text-gray-800 font-semibold">@attr.AttributeValue</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.GeneralFeatures))
                {
                    <div class="space-y-4">
                        <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2 px-2">
                            <i class="fa-solid fa-bolt-lightning text-[#009933]"></i> คุณสมบัติเด่น
                        </h2>

                        <div class="grid grid-cols-1 gap-4">
                            @foreach (var feature in Model.GeneralFeatures.Split('|'))
                            {
                                if (!string.IsNullOrWhiteSpace(feature))
                                {
                                    <div class="flex items-center gap-4 bg-white p-5 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:border-[#009933]/30 transition-all group">
                                        <div class="w-8 h-8 rounded-full bg-green-50 flex items-center justify-center shrink-0 group-hover:bg-[#009933] transition-colors">
                                            <i class="fa-solid fa-check text-[10px] text-[#009933] group-hover:text-white"></i>
                                        </div>
                                        <span class="text-gray-700 font-bold text-sm whitespace-normal">@feature.Trim()</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.FullContent))
                {
                    <div class="bg-white p-10 rounded-[2.5rem] border border-gray-100 shadow-sm">
                        <h3 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                            <i class="fa-solid fa-circle-info text-[#009933]"></i> รายละเอียดโดยละเอียด
                        </h3>
                        <div class="prose max-w-none text-gray-600 leading-loose">
                            @Html.Raw(Model.FullContent)
                        </div>
                    </div>
                }

                <div class="relative overflow-hidden rounded-[2.5rem] bg-slate-950 shadow-2xl shadow-green-900/30 p-1">
                    <div class="absolute -right-16 -top-16 w-64 h-64 bg-[#009933]/20 rounded-full blur-[80px]"></div>
                    <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-emerald-500/10 rounded-full blur-[80px]"></div>

                    <div class="relative z-10 bg-slate-900/40 backdrop-blur-3xl rounded-[2.2rem] p-8 md:p-10 border border-white/5">
                        <div class="flex flex-col md:flex-row items-center justify-center gap-6">

                            <a asp-controller="Home" asp-action="Contact"
                               class="w-full md:w-auto flex items-center justify-center gap-4 bg-white/5 hover:bg-white/10 text-white px-10 py-5 rounded-2xl font-bold border border-white/10 transition-all duration-300 hover:-translate-y-1 active:translate-y-0 group">
                                <i class="fa-solid fa-comments text-green-400 text-xl group-hover:rotate-12 transition-transform"></i>
                                <span class="text-lg">ติดต่อเรา</span>
                            </a>

                            @if (SignInManager.IsSignedIn(User))
                            {
                                <button onclick="openQuoteModal()"
                                        class="relative w-full md:w-auto flex items-center justify-center gap-4 bg-gradient-to-r from-yellow-400 via-amber-500 to-orange-500 text-slate-950 px-12 py-5 rounded-2xl font-black shadow-[0_15px_40px_rgba(245,158,11,0.25)] hover:shadow-[0_20px_50px_rgba(245,158,11,0.4)] transition-all duration-300 hover:-translate-y-1 active:translate-y-0 group/btn overflow-hidden">
                                    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent -translate-x-full group-hover/btn:animate-shine"></div>
                                    <i class="fa-solid fa-cart-plus text-xl group-hover/btn:scale-110 transition-transform"></i>
                                    <span class="text-lg">เพิ่มลงตะกร้าขอใบเสนอราคา</span>
                                </button>
                                <a asp-controller="Cart" asp-action="Index"
                                   class="w-full md:w-auto flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 text-white px-6 py-5 rounded-2xl font-bold border border-white/10 transition-all duration-300">
                                    <i class="fa-solid fa-cart-shopping text-green-400"></i> ดูตะกร้า
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"
                                   class="relative w-full md:w-auto flex flex-col items-center justify-center bg-white/10 hover:bg-white/15 text-white px-12 py-4 rounded-2xl border border-white/10 transition-all duration-300 hover:-translate-y-1 group">
                                    <div class="flex items-center gap-3">
                                        <i class="fa-solid fa-lock text-yellow-400"></i>
                                        <span class="font-bold text-lg">เข้าสู่ระบบเพื่อขอใบเสนอราคา</span>
                                    </div>
                                    <span class="text-[10px] text-gray-400 uppercase tracking-widest mt-1 font-medium">Authentication required</span>
                                </a>
                            }

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div id="quoteModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center z-[100] p-4 sm:p-6 animate-fadeInShort">

    <div class="relative w-full max-w-md bg-white rounded-[1.5rem] shadow-2xl flex flex-col max-h-[90vh] overflow-hidden animate-slideUp">

        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between shrink-0 bg-white z-10">
            <div>
                <h2 class="text-xl font-black text-gray-900 tracking-tight flex items-center gap-2">
                    <span class="w-1.5 h-5 rounded-md bg-[#009933]"></span>เพิ่มลงตะกร้า
                </h2>
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-0.5">Add to Quotation Cart</p>
            </div>
            <button type="button" onclick="closeQuoteModal()" class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-50 hover:bg-red-50 text-gray-400 hover:text-red-500 transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form method="post" asp-controller="Cart" asp-action="Add" class="flex flex-col flex-1 overflow-hidden">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

            <div class="p-6 overflow-y-auto custom-scrollbar flex-1 space-y-5 bg-gray-50/30">

                <div class="p-3 bg-white rounded-xl border border-gray-100 flex items-center gap-4 shadow-sm">
                    <img src="@Model.ImageUrl" class="w-14 h-14 rounded-lg object-cover shadow-sm border border-gray-50 shrink-0" alt="@Model.Name">
                    <div class="overflow-hidden">
                        <span class="text-[9px] font-bold text-[#009933] bg-[#009933]/10 px-2 py-0.5 rounded uppercase tracking-wider">สินค้าที่เลือก</span>
                        <p class="text-sm font-bold text-gray-800 truncate mt-1">@Model.Name</p>
                    </div>
                </div>

                <div class="relative group">
                    <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1 pl-1">
                        จำนวน <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <i class="fa-solid fa-layer-group absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-[#009933] transition-colors text-sm z-10"></i>
                        <input type="number" name="qty" id="qtyInput" min="1" value="1"
                               class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none transition-all font-semibold text-gray-800 text-sm" required>
                    </div>
                </div>

                <p class="text-xs text-gray-400 leading-relaxed">
                    <i class="fa-solid fa-circle-info mr-1"></i>
                    เพิ่มสินค้าได้หลายรายการ/หลายหมวดหมู่ลงตะกร้าเดียวกัน แล้วค่อยกรอกข้อมูลติดต่อและส่งขอใบเสนอราคาทีเดียวในหน้าตะกร้า
                </p>

            </div>

            <div class="px-6 py-4 bg-white border-t border-gray-100 flex gap-3 shrink-0">
                <button type="button" onclick="closeQuoteModal()"
                        class="flex-1 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-600 rounded-lg font-bold transition-all active:scale-95 text-sm">
                    ยกเลิก
                </button>

                <button type="submit" id="btnSubmitQuote"
                        onclick="handleQuoteSubmit(this, event)"
                        class="flex-[2] py-2.5 bg-[#009933] hover:bg-green-700 text-white rounded-lg font-bold transition-all shadow-[0_4px_15px_rgba(0,153,51,0.2)] hover:shadow-[0_6px_20px_rgba(0,153,51,0.3)] active:scale-95 text-sm flex items-center justify-center gap-2">
                    <i class="fa-solid fa-cart-plus"></i> <span id="btnSubmitQuoteText">เพิ่มลงตะกร้า</span>
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    /* Custom Scrollbar for Modal Body */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background-color: #94a3b8;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .animate-fadeInShort {
        animation: fadeIn 0.2s ease-out forwards;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .animate-slideUp {
        animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes shine {
        100% {
            transform: translateX(100%);
        }
    }

    .animate-shine {
        animation: shine 0.9s ease-in-out infinite;
    }

    .prose p {
        margin-bottom: 1.5rem;
        color: #4b5563;
        line-height: 1.8;
    }

    #quoteModal::-webkit-scrollbar {
        width: 0px;
    }
</style>

<script>
    function openQuoteModal() {
        const modal = document.getElementById('quoteModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeQuoteModal() {
        const modal = document.getElementById('quoteModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = 'auto';
    }

    function handleQuoteSubmit(btn, event) {
        const form = btn.closest('form');
        if (form.checkValidity()) {
            btn.classList.add('opacity-80', 'cursor-not-allowed');
            btn.style.pointerEvents = 'none';
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> <span>กำลังส่งข้อมูล...</span>';
        }
    }

    window.onclick = function (event) {
        const modal = document.getElementById('quoteModal');
        if (event.target == modal) {
            closeQuoteModal();
        }
    }
</script>