@model PPMEnergyWeb.Models.Supplier
@using PPMEnergyWeb.Models
@{
    ViewData["Title"] = "เพิ่มซัพพลายเออร์";
    Layout = "_LayoutAdmin";
    var allCategories = (List<Category>)ViewBag.AllCategories;
    var mainCats = allCategories.Where(c => c.ParentCategoryId == null).ToList();
    var selectedIds = new List<int>();
}

<div class="space-y-6 max-w-4xl mx-auto">
    <a asp-action="Index" class="inline-flex items-center text-sm font-semibold text-gray-500 hover:text-ppmgreen transition-colors">
        <i class="fa-solid fa-arrow-left mr-2 text-xs"></i> ย้อนกลับไปหน้ารายชื่อซัพพลายเออร์
    </a>

    <div class="bg-white border border-gray-200/80 shadow-sm rounded-2xl overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/50">
            <h2 class="text-lg font-bold text-gray-900">ข้อมูลซัพพลายเออร์ใหม่</h2>
            <p class="text-xs text-gray-500 mt-0.5">บริษัทที่ PPM ติดต่อ/รับสินค้ามาจำหน่าย</p>
        </div>

        <form asp-action="Create" method="post" class="p-6 space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs font-semibold"></div>

            @await Html.PartialAsync("_SupplierFormFields", Model, new ViewDataDictionary(ViewData) { { "MainCats", mainCats }, { "SelectedIds", selectedIds } })

            <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
                <button type="submit" class="px-5 py-2.5 bg-ppmgreen text-white text-sm font-bold rounded-xl hover:bg-ppmgreen-dark transition-all shadow-sm shadow-ppmgreen/10">
                    <i class="fa-solid fa-floppy-disk mr-2"></i> บันทึกซัพพลายเออร์
                </button>
                <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-600 text-sm font-bold rounded-xl hover:bg-gray-200 transition-all">ยกเลิก</a>
            </div>
        </form>
    </div>
</div>
