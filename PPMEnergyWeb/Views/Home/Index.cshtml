                        <div class="flex items-center gap-4 mb-4">
                            <span class="text-5xl sm:text-6xl font-extrabold text-primary/10 font-headline-display">02</span>
                            <div class="h-px bg-primary/20 flex-grow"></div>
                            <span class="text-primary font-label-md tracking-widest uppercase">Heavy Industry</span>
