<div class="font-body text-slate-800 antialiased overflow-x-hidden">

    <style>
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes shimmer {
            100% {
                transform: translateX(100%);
            }
        }

        .animate-fade-in-up {
            animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
        }

        .delay-100 {
            animation-delay: 100ms;
        }

        .delay-200 {
            animation-delay: 200ms;
        }

        .delay-300 {
            animation-delay: 300ms;
        }

        .delay-400 {
            animation-delay: 400ms;
        }

        .delay-500 {
            animation-delay: 500ms;
        }
    </style>

    @* ── ส่วน Hero Section เดิม ── *@
    <section class="relative min-h-screen flex items-center overflow-hidden bg-slate-950">

        <div class="absolute inset-0 z-0">
            <video autoplay loop muted playsinline class="w-full h-full object-cover transform scale-105 pointer-events-none">
                <source src="~/videos/ppmvideo1.mp4" type="video/mp4">
            </video>

            <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 via-slate-950/40 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
            <div class="absolute -left-20 top-1/4 w-[600px] h-[600px] bg-emerald-500/10 rounded-full blur-[150px] pointer-events-none"></div>
        </div>

        <div class="relative z-10 w-full max-w-7xl mx-auto px-6 py-24 sm:py-32 lg:py-0">
            <div class="max-w-xl md:max-w-2xl space-y-6 sm:space-y-8">

                <div class="animate-fade-in-up delay-100 inline-flex items-center gap-3 px-4 py-2 rounded-full bg-slate-900/60 border border-white/10 backdrop-blur-md hover:border-emerald-500/30 transition-all duration-300">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                    <span class="text-xs font-bold text-slate-300 tracking-[0.15em] uppercase">PPM Energy (Thailand)</span>
                </div>

                <div class="animate-fade-in-up delay-200 space-y-3">
                    <h1 class="text-5xl sm:text-6xl lg:text-8xl font-black text-white tracking-tight leading-none">
                        PPM <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-emerald-500">Energy</span>
                    </h1>
                    <p class="text-2xl sm:text-3xl font-extrabold text-slate-100 tracking-wide mt-2">
                        ขับเคลื่อนอุตสาหกรรม ด้วยพลังงานคุณภาพสูง
                    </p>
                </div>

                <p class="animate-fade-in-up delay-300 text-base sm:text-lg text-slate-300 leading-relaxed font-light max-w-lg border-l-2 border-emerald-500/50 pl-5">
                    ผู้เชี่ยวชาญด้านพลังงานทดแทน บริการขนส่ง และให้คำปรึกษาระบบวิศวกรรมโรงงานแบบครบวงจร เพื่อเสถียรภาพและการเติบโตที่ยั่งยืนของธุรกิจคุณ
                </p>

                <div class="animate-fade-in-up delay-400 flex flex-col sm:flex-row gap-4 pt-2">
                    <a asp-controller="Home" asp-action="Contact" class="group relative px-8 py-4 bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-bold rounded-xl shadow-[0_0_25px_rgba(16,185,129,0.25)] hover:shadow-[0_0_35px_rgba(16,185,129,0.45)] transition-all duration-300 hover:-translate-y-1 text-center overflow-hidden active:scale-98">
                        <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]"></div>
                        <span class="relative flex items-center justify-center gap-2 tracking-wide">
                            ปรึกษาผู้เชี่ยวชาญ
                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </span>
                    </a>

                    <a asp-controller="Home" asp-action="Services" class="px-8 py-4 bg-white/5 hover:bg-white/10 text-white border border-white/10 hover:border-white/30 font-bold rounded-xl backdrop-blur-md transition-all duration-300 hover:-translate-y-1 text-center flex items-center justify-center tracking-wide active:scale-98">
                        ดูบริการของเรา
                    </a>
                </div>

                <div class="animate-fade-in-up delay-500 pt-6 grid grid-cols-3 gap-4 max-w-md border-t border-white/5 text-slate-400 text-xs sm:text-sm">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-emerald-500"></i>
                        <span>ปลอดภัย 100%</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-clock text-emerald-500"></i>
                        <span>บริการ 24 ชม.</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-award text-emerald-500"></i>
                        <span>มาตรฐานสากล</span>
                    </div>
                </div>

            </div>
        </div>

        <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-fade-in-up delay-500 z-10 flex flex-col items-center opacity-40 hover:opacity-100 transition-opacity duration-300 cursor-pointer">
            <span class="text-white text-[10px] tracking-[0.3em] uppercase mb-2">Scroll</span>
            <div class="w-5 h-9 border border-white/30 rounded-full flex justify-center p-1">
                <div class="w-1 h-1.5 bg-emerald-400 rounded-full animate-bounce mt-0.5"></div>
            </div>
        </div>

    </section>

    @* 🎬 ส่วนวิดีโอแนะนำด้านบนสุด: แสดงผลเฉพาะเมื่อกดหน้าหลัก (เมื่อไม่มีการเลือกหมวดหมู่สินค้า) *@
    @if (string.IsNullOrEmpty(ViewData["CurrentCategoryCode"]?.ToString()) && string.IsNullOrEmpty(ViewData["CurrentSubCode"]?.ToString()))
    {
        <section class="relative bg-slate-950 py-12 sm:py-16 border-b border-white/5">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

                <div class="animate-fade-in-up delay-100 mb-6 text-center lg:text-left">
                    <span class="text-xs font-bold text-emerald-400 tracking-[0.2em] uppercase block mb-2">Company Profile</span>
                    <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
                        PPM <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Energy</span> Video Presentation
                    </h2>
                </div>

                <div class="animate-fade-in-up delay-100 relative w-full aspect-video rounded-2xl overflow-hidden shadow-2xl border border-white/10 bg-black">
                    @* 💡 วิธีใช้งาน: 
                        สามารถเปลี่ยนชื่อไฟล์ใน src="..." เป็นชื่อไฟล์วิดีโอแนะนำบริษัทที่คุณต้องการเก็บไว้ใน wwwroot ได้เลยครับ
                    *@
                    <video controls preload="metadata" class="w-full h-full object-contain">
                        <source src="~/videos/PPM ENERGY VIDEO EDIT.mp4" type="video/mp4">
                        <p class="text-white p-4">เบราว์เซอร์ของคุณไม่รองรับการเล่นวิดีโอ</p>
                    </video>
                </div>

            </div>
        </section>
    }

    @* ── ส่วน Our Core Business ที่นำเข้ามาแทรก ── *@
