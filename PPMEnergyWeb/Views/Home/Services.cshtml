@{
    ViewData["Title"] = "บริการของเรา";
}

<section class="relative bg-[#0f172a] py-20 overflow-hidden">
    <div class="absolute inset-0 opacity-20">
        <img src="~/images/A1.png"
             class="w-full h-full object-cover"
             alt="Industrial Services Background"
             onerror="this.src='https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&q=80&w=2070'">
    </div>
    <div class="relative max-w-7xl mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-black text-white mb-4">บริการของเรา</h1>
        <p class="text-ppmgreen font-bold tracking-[0.2em] uppercase text-sm">Professional Services</p>
    </div>
</section>

<section class="relative min-h-screen py-24 overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&q=80&w=2070"
             class="w-full h-full object-cover object-center" alt="Industrial Services Background">
        <div class="absolute inset-0 bg-slate-50/85 backdrop-blur-sm"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 lg:px-20">

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-16">

            <div class="group transform hover:-translate-y-1 transition-transform duration-300">
                <div class="w-14 h-14 bg-white shadow-sm border border-gray-200/60 rounded-xl flex items-center justify-center mb-6">
                    <i class="fa-solid fa-users-gear text-2xl text-ppmgreen"></i>
                </div>
                <h3 class="text-xl font-black text-gray-900 mb-1 group-hover:text-ppmgreen transition-colors duration-300">บริการด้านทีมขาย</h3>
                <div class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-4">Sale Service</div>
                <p class="text-gray-600 leading-relaxed font-medium text-sm">
                    ทีมขายมืออาชีพ พร้อมให้คำปรึกษาด้านสินค้าและระบบงานอุตสาหกรรมอย่างครบวงจร
                    ช่วยวิเคราะห์ต้นทุน แนะนำโซลูชันที่เหมาะสม และดูแลลูกค้าอย่างใกล้ชิด
                    เพื่อให้ทุกธุรกิจดำเนินงานได้อย่างมีประสิทธิภาพสูงสุด
                </p>
            </div>

            <div class="group transform hover:-translate-y-1 transition-transform duration-300">
                <div class="w-14 h-14 bg-white shadow-sm border border-gray-200/60 rounded-xl flex items-center justify-center mb-6">
                    <i class="fa-solid fa-award text-2xl text-ppmgreen"></i>
                </div>
                <h3 class="text-xl font-black text-gray-900 mb-1 group-hover:text-ppmgreen transition-colors duration-300">ด้านคุณภาพ</h3>
                <div class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-4">Quality Control</div>
                <p class="text-gray-600 leading-relaxed font-medium text-sm">
                    คัดสรรสินค้าและวัตถุดิบคุณภาพมาตรฐาน ผ่านการตรวจสอบอย่างเป็นระบบ
                    โดยทีมงาน QC มืออาชีพ เพื่อสร้างความมั่นใจในทุกขั้นตอนการใช้งาน
                    พร้อมตอบโจทย์งานอุตสาหกรรมอย่างมีประสิทธิภาพ
                </p>
            </div>

            <div class="group transform hover:-translate-y-1 transition-transform duration-300">
                <div class="w-14 h-14 bg-white shadow-sm border border-gray-200/60 rounded-xl flex items-center justify-center mb-6">
                    <i class="fa-solid fa-headset text-2xl text-ppmgreen"></i>
                </div>
                <h3 class="text-xl font-black text-gray-900 mb-1 group-hover:text-ppmgreen transition-colors duration-300">ประสานงานขาย</h3>
                <div class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-4">Sale Coordinator</div>
                <p class="text-gray-600 leading-relaxed font-medium text-sm">
                    บริการประสานงานขายอย่างรวดเร็วและเป็นระบบ
                    เพื่อความสะดวก โปร่งใส และสร้างความมั่นใจให้กับลูกค้า
                </p>
            </div>

            <div class="group transform hover:-translate-y-1 transition-transform duration-300">
                <div class="w-14 h-14 bg-white shadow-sm border border-gray-200/60 rounded-xl flex items-center justify-center mb-6">
                    <i class="fa-solid fa-truck-fast text-2xl text-ppmgreen"></i>
                </div>
                <h3 class="text-xl font-black text-gray-900 mb-1 group-hover:text-ppmgreen transition-colors duration-300">บริการขนส่งสินค้า</h3>
                <div class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-4">Logistics Solution</div>
                <p class="text-gray-600 leading-relaxed font-medium text-sm">
                    บริการขนส่งสินค้าครอบคลุมทุกพื้นที่ ด้วยทีมงานมืออาชีพ
                    จัดส่งตรงเวลา ปลอดภัย และรองรับการให้บริการตลอด 24 ชั่วโมง
                    เพื่อให้สินค้าถึงมือลูกค้าอย่างมีประสิทธิภาพสูงสุด
                </p>
            </div>

            <div class="group transform hover:-translate-y-1 transition-transform duration-300">
                <div class="w-14 h-14 bg-white shadow-sm border border-gray-200/60 rounded-xl flex items-center justify-center mb-6">
                    <i class="fa-solid fa-handshake-angle text-2xl text-ppmgreen"></i>
                </div>
                <h3 class="text-xl font-black text-gray-900 mb-1 group-hover:text-ppmgreen transition-colors duration-300">บริการหลังการขาย</h3>
                <div class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-4">Maintenance Support</div>
                <p class="text-gray-600 leading-relaxed font-medium text-sm">
                    ดูแลและให้คำปรึกษาหลังการขายอย่างครบวงจร
                    พร้อมทีมช่างและผู้เชี่ยวชาญคอยดูแล แก้ไข และตรวจเช็กระบบต่าง ๆ
                    เพื่อให้เครื่องจักรและอุปกรณ์ทำงานได้อย่างเต็มประสิทธิภาพ
                </p>
            </div>

            <div class="group transform hover:-translate-y-1 transition-transform duration-300">
                <div class="w-14 h-14 bg-white shadow-sm border border-gray-200/60 rounded-xl flex items-center justify-center mb-6">
                    <i class="fa-solid fa-microchip text-2xl text-ppmgreen"></i>
                </div>
                <h3 class="text-xl font-black text-gray-900 mb-1 group-hover:text-ppmgreen transition-colors duration-300">เทคโนโลยีอุตสาหกรรม</h3>
                <div class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-4">Innovation</div>
                <p class="text-gray-600 leading-relaxed font-medium text-sm">
                    นำเทคโนโลยีอุตสาหกรรมสมัยใหม่เข้ามาพัฒนาระบบการทำงาน
                    เพื่อเพิ่มความรวดเร็ว แม่นยำ และยกระดับประสิทธิภาพในทุกกระบวนการ
                    ตอบโจทย์ธุรกิจยุคใหม่ด้วยนวัตกรรมที่ทันสมัย
                </p>
            </div>

        </div>
    </div>
</section>