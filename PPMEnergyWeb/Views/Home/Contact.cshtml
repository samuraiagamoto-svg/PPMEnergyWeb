@{
    ViewData["Title"] = "ติดต่อเรา";
}

<!-- 🌟 ส่วนหัว (Hero Section) -->
<section class="relative bg-slate-900 py-24 overflow-hidden border-b border-gray-800">
    <!-- ภาพพื้นหลัง -->
    <div class="absolute inset-0 opacity-20">
        <img src="~/images/About.png"
             class="w-full h-full object-cover"
             alt="Industrial Services Background"
             onerror="this.src='https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&q=80&w=2070'">
        <!-- Gradient Overlay เพื่อให้ตัวหนังสือลอยเด่นขึ้น -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-black text-white mb-4 tracking-tight">ติดต่อเรา</h1>
        <p class="text-[#006633] font-bold tracking-[0.25em] uppercase text-sm bg-white/10 inline-block px-4 py-1.5 rounded-full backdrop-blur-sm border border-white/5">
            ยินดีให้บริการทุกขั้นตอน
        </p>
    </div>
</section>

<!-- 🏢 ส่วนเนื้อหาหลัก (Main Content) -->
<div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">

        <!-- 📌 คอลัมน์ซ้าย: ข้อมูลการติดต่อ -->
        <div class="space-y-6 flex flex-col justify-center">

            <!-- การ์ดข้อมูลสำนักงานใหญ่ (Premium Design) -->
            <div class="bg-white rounded-3xl border border-gray-100 shadow-[0_4px_25px_-5px_rgba(0,0,0,0.05)] p-8 sm:p-10 transition-all duration-300 hover:shadow-[0_10px_30px_-5px_rgba(0,102,51,0.08)]">
                <h2 class="text-2xl font-bold text-gray-900 mb-8 flex items-center gap-3 border-b border-gray-100 pb-5">
                    <div class="w-12 h-12 rounded-2xl bg-[#006633]/10 flex items-center justify-center text-[#006633]">
                        <i class="fa-solid fa-location-dot text-xl"></i>
                    </div>
                    สำนักงานใหญ่
                </h2>

                <div class="space-y-7">
                    <!-- 1. ที่อยู่ -->
                    <div class="flex items-start gap-4 group">
                        <div class="w-12 h-12 shrink-0 flex items-center justify-center bg-gray-50 rounded-2xl group-hover:bg-[#006633]/10 group-hover:text-[#006633] transition-all duration-300 text-gray-400">
                            <i class="fa-solid fa-map-location-dot text-lg"></i>
                        </div>
                        <div class="pt-1">
                            <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">ที่อยู่บริษัท</p>
                            <p class="text-gray-700 font-medium leading-relaxed text-sm">
                                16 หมู่ที่ 2 ตำบลบ้านช้าง <br />
                                อำเภออุทัย จังหวัดพระนครศรีอยุธยา 13210
                            </p>
                        </div>
                    </div>

                    <!-- 2. โทรศัพท์ -->
                    <div class="flex items-start gap-4 group">
                        <div class="w-12 h-12 shrink-0 flex items-center justify-center bg-gray-50 rounded-2xl group-hover:bg-[#006633]/10 group-hover:text-[#006633] transition-all duration-300 text-gray-400">
                            <i class="fa-solid fa-phone text-lg"></i>
                        </div>
                        <div class="pt-1">
                            <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">เบอร์โทรศัพท์</p>
                            <div class="flex flex-col gap-1.5">
                                <a href="tel:035245899" class="text-gray-800 font-bold hover:text-[#006633] transition-colors text-sm">035-245-899</a>
                                <a href="tel:0970354469" class="text-gray-800 font-bold hover:text-[#006633] transition-colors text-sm">097-035-4469</a>
                            </div>
                        </div>
                    </div>

                    <!-- 3. อีเมล -->
                    <div class="flex items-start gap-4 group">
                        <div class="w-12 h-12 shrink-0 flex items-center justify-center bg-gray-50 rounded-2xl group-hover:bg-[#006633]/10 group-hover:text-[#006633] transition-all duration-300 text-gray-400">
                            <i class="fa-solid fa-envelope text-lg"></i>
                        </div>
                        <div class="pt-1">
                            <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">อีเมล</p>
                            <a href="mailto:ppm.energy1989@gmail.com" class="text-gray-800 font-bold hover:text-[#006633] transition-colors text-sm break-all">
                                ppm.energy1989@gmail.com
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- กล่องเวลาทำการ -->
            <div class="bg-[#111827] text-white p-6 sm:px-8 sm:py-6 rounded-3xl shadow-lg flex justify-between items-center border border-gray-800">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-amber-400/10 flex items-center justify-center text-amber-400 shrink-0">
                        <i class="fa-regular fa-clock text-lg"></i>
                    </div>
                    <div>
                        <p class="text-gray-400 text-[11px] font-bold uppercase tracking-wider mb-0.5">เวลาทำการ</p>
                        <p class="font-bold text-sm tracking-wide">จันทร์ - ศุกร์: <span class="text-amber-400 ml-1">09:00 - 17:00 น.</span></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 🗺️ คอลัมน์ขวา: Google Maps -->
        <div class="h-full min-h-[450px] lg:min-h-full bg-gray-100 rounded-3xl overflow-hidden shadow-[0_4px_25px_-5px_rgba(0,0,0,0.05)] border border-gray-200 relative group">
            <!-- เพิ่ม Overlay เล็กน้อยตอนโฮเวอร์ให้ดูมีลูกเล่น -->
            <div class="absolute inset-0 bg-[#006633]/0 pointer-events-none transition-colors duration-500 group-hover:bg-[#006633]/5 z-10"></div>
            <iframe width="100%"
                    height="100%"
                    style="border:0;"
                    loading="lazy"
                    allowfullscreen
                    referrerpolicy="no-referrer-when-downgrade"
                    class="absolute inset-0 w-full h-full object-cover"
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3864.881261623831!2d100.6807239757963!3d14.32937628612501!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x30e28b71c3e4d985%3A0x6bfe08a9b65c2b92!2z4Lie4Li14Lie4Lie4LmA4Lih4LmA4Lit4LmA4LiI4Li1KOC4hOC4o-C4reC5guC4reC4p-C4p-C4seC4hOC5geC4leC4nuC4meC5geC4hOC4reC4hOC5gOC4geC4suC4leC4nuC4seC4leC4peC4leC5iOC4nuC4o-C5guC4leC4oeC4oSk!5e0!3m2!1sth!2sth!4v1713241000000!5m2!1sth!2sth">
            </iframe>
        </div>

    </div>
</div>