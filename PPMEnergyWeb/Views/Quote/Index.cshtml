@model IEnumerable<PPMEnergyWeb.Models.Quote>

@{
    ViewData["Title"] = "รายการขอใบเสนอราคา";
    Layout = "_LayoutAdmin";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-black text-gray-900 tracking-tight flex items-center gap-2">
                <span class="w-1.5 h-6 rounded-md bg-[#009933]"></span>จัดการใบเสนอราคา
            </h2>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-1">Quotation Dashboard</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-center justify-between p-4 bg-green-50 border-l-4 border-[#009933] text-green-800 rounded-r-xl shadow-sm transition-all animate-fadeIn" role="alert">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-circle-check text-[#009933] text-xl"></i>
                <span class="font-medium text-sm">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-green-400 hover:text-green-600 transition-colors">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white border-l-4 border-blue-500 rounded-2xl p-5 shadow-sm flex items-center justify-between transition-transform hover:-translate-y-1">
            <div>
                <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">รายการขอใหม่ (รอตรวจ)</p>
                <h3 class="text-2xl font-black text-gray-800 mt-1">@ViewBag.NewRequests <span class="text-xs font-normal text-gray-400">รายการ</span></h3>
            </div>
            <div class="w-12 h-12 flex items-center justify-center bg-blue-50 text-blue-500 rounded-xl">
                <i class="fa-solid fa-bell text-xl"></i>
            </div>
        </div>

        <div class="bg-white border-l-4 border-amber-500 rounded-2xl p-5 shadow-sm flex items-center justify-between transition-transform hover:-translate-y-1">
            <div>
                <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">กำลังทำราคา</p>
                <h3 class="text-2xl font-black text-gray-800 mt-1">@ViewBag.InProgress <span class="text-xs font-normal text-gray-400">รายการ</span></h3>
            </div>
            <div class="w-12 h-12 flex items-center justify-center bg-amber-50 text-amber-500 rounded-xl">
                <i class="fa-solid fa-spinner fa-spin text-xl"></i>
            </div>
        </div>

        <div class="bg-white border-l-4 border-red-500 rounded-2xl p-5 shadow-sm flex items-center justify-between transition-transform hover:-translate-y-1">
            <div>
                <p class="text-[11px] font-bold text-red-500 uppercase tracking-wider">⚠️ ล่าช้า (>24 ชม.)</p>
                <h3 class="text-2xl font-black text-red-600 mt-1">@(ViewBag.OverdueRequests ?? 0) <span class="text-xs font-normal text-gray-400">รายการ</span></h3>
            </div>
            <div class="w-12 h-12 flex items-center justify-center bg-red-50 text-red-500 rounded-xl">
                <i class="fa-solid fa-triangle-exclamation text-xl"></i>
            </div>
        </div>

        <div class="bg-white border-l-4 border-[#009933] rounded-2xl p-5 shadow-sm flex items-center justify-between transition-transform hover:-translate-y-1">
            <div>
                <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">ดำเนินการสำเร็จแล้ว</p>
                <h3 class="text-2xl font-black text-gray-800 mt-1">
                    @String.Format("{0:N0}", ViewBag.CompletedRequests ?? 0) <span class="text-xs font-normal text-gray-400">ใบ</span>
                </h3>
            </div>
            <div class="w-12 h-12 flex items-center justify-center bg-green-50 text-[#009933] rounded-xl">
                <i class="fa-solid fa-circle-check text-xl"></i>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="col-span-1 lg:col-span-2 bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
            <h3 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-chart-line text-blue-500"></i> แนวโน้มคำขอใบเสนอราคา (7 วันล่าสุด)
            </h3>
            <div class="relative h-[250px] w-full">
                <canvas id="trendChart"></canvas>
            </div>
        </div>

        <div class="col-span-1 bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
            <h3 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-fire text-amber-500"></i> Top 5 สินค้ายอดฮิต
            </h3>
            <div class="relative h-[250px] w-full">
                <canvas id="topProductsChart"></canvas>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 flex flex-wrap gap-2">
        @{
            var statusFilters = new (PPMEnergyWeb.Models.QuoteStatus Status, string Label, string Icon)[]
            {
                (PPMEnergyWeb.Models.QuoteStatus.New, "มาใหม่", "fa-solid fa-bell"),
                (PPMEnergyWeb.Models.QuoteStatus.Processing, "กำลังดำเนินการ", "fa-solid fa-spinner"),
                (PPMEnergyWeb.Models.QuoteStatus.QuotationSent, "ส่งใบเสนอราคาแล้ว", "fa-regular fa-paper-plane"),
                (PPMEnergyWeb.Models.QuoteStatus.Won, "ปิดการขายได้", "fa-solid fa-circle-check"),
                (PPMEnergyWeb.Models.QuoteStatus.Lost, "ยกเลิก", "fa-solid fa-xmark"),
            };
            var activeStatus = (PPMEnergyWeb.Models.QuoteStatus)ViewBag.CurrentStatus;
        }
        @foreach (var sf in statusFilters)
        {
            bool isActive = sf.Status == activeStatus;
            <a asp-action="Index"
               asp-route-status="@sf.Status"
               asp-route-search="@Context.Request.Query["search"]"
               asp-route-fromDate="@Context.Request.Query["fromDate"]"
               class="px-4 py-2 rounded-xl text-sm font-bold transition-all flex items-center gap-2 @(isActive ? "bg-[#009933] text-white shadow-lg shadow-green-500/20" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                <i class="@sf.Icon text-xs"></i> @sf.Label
            </a>
        }
    </div>

    <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
        <form method="get" asp-action="Index" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <input type="hidden" name="status" value="@ViewBag.CurrentStatus" />
            <div class="col-span-1 md:col-span-5">
                <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2 pl-1">ค้นหาด่วน</label>
                <div class="relative group">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-[#009933] transition-colors"></i>
                    <input type="text" name="search" value="@Context.Request.Query["search"]" class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none transition-all text-sm" placeholder="บริษัท, ชื่อผู้ติดต่อ, อีเมล..." />
                </div>
            </div>

            <div class="col-span-1 md:col-span-4">
                <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2 pl-1">ตั้งแต่วันที่</label>
                <div class="relative group">
                    <i class="fa-solid fa-calendar-days absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-[#009933] transition-colors"></i>
                    <input type="date" name="fromDate" value="@Context.Request.Query["fromDate"]" class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none transition-all text-sm" />
                </div>
            </div>

            <div class="col-span-1 md:col-span-3 flex gap-2">
                <button type="submit" class="flex-[2] bg-[#009933] hover:bg-green-700 text-white font-bold text-sm rounded-xl py-2.5 shadow-lg shadow-green-500/20 transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-filter"></i> กรองข้อมูล
                </button>
                <a asp-action="Index" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-500 font-bold text-sm rounded-xl py-2.5 transition-all flex items-center justify-center" title="ล้างค่า">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto custom-scrollbar">
            <table class="min-w-full divide-y divide-gray-100">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-5 py-4 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider">บริษัท / ผู้ติดต่อ</th>
                        <th class="px-5 py-4 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider">สินค้า / จำนวน</th>
                        <th class="px-5 py-4 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider">สถานที่จัดส่ง</th>
                        <th class="px-5 py-4 text-center text-[11px] font-bold text-gray-500 uppercase tracking-wider">วันที่ส่งคำขอ</th>
                        <th class="px-5 py-4 text-center text-[11px] font-bold text-gray-500 uppercase tracking-wider">สถานะ</th>
                        <th class="px-5 py-4 text-center text-[11px] font-bold text-gray-500 uppercase tracking-wider">จัดการ</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-50">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center text-gray-400">
                                <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-3">
                                    <i class="fa-solid fa-folder-open text-2xl text-gray-300"></i>
                                </div>
                                <span class="text-sm font-bold text-gray-500">ไม่พบข้อมูลคำขอใบเสนอราคา</span>
                                <p class="text-xs text-gray-400 mt-1">ลองเปลี่ยนเงื่อนไขการค้นหาใหม่อีกครั้ง</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50/50 transition-colors group">
                                <td class="px-5 py-4">
                                    <div class="text-sm font-bold text-gray-800">@item.CompanyName</div>
                                    <div class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                                        <i class="fa-solid fa-user-tie text-gray-400"></i> @item.ContactName
                                    </div>
                                    <div class="text-[11px] text-gray-500 mt-0.5 flex items-center gap-1">
                                        <i class="fa-solid fa-phone text-gray-400"></i> @item.Phone
                                    </div>
                                </td>

                                <td class="px-5 py-4">
                                    @{
                                        var detail = item.QuoteDetails?.FirstOrDefault();
                                        if (detail != null)
                                        {
                                            <div class="text-sm font-bold text-slate-700 truncate max-w-[200px]" title="@detail.ProductName">
                                                @detail.ProductName
                                            </div>
                                            <div class="text-xs font-bold text-[#009933] mt-1 bg-green-50 inline-block px-2 py-0.5 rounded">
                                                จำนวน: @detail.Quantity ชิ้น
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-400 italic">ไม่มีข้อมูลสินค้า</span>
                                        }
                                    }
                                </td>

                                <td class="px-5 py-4">
                                    <div class="text-xs font-semibold text-gray-700 flex items-start gap-1.5 truncate max-w-[220px]" title="@item.DeliveryLocation">
                                        <i class="fa-solid fa-location-dot text-red-500 mt-0.5 shrink-0"></i>
                                        <span class="truncate">
                                            @(string.IsNullOrEmpty(item.DeliveryLocation) ? "ไม่ได้ระบุสถานที่จัดส่ง" : item.DeliveryLocation)
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Note))
                                    {
                                        <div class="text-[11px] text-amber-600 bg-amber-50 px-2 py-1 rounded mt-1.5 truncate max-w-[220px]" title="@item.Note">
                                            <i class="fa-solid fa-note-sticky mr-1"></i>โน้ต: @item.Note
                                        </div>
                                    }
                                </td>

                                <td class="px-5 py-4 text-center">
                                    <div class="text-sm font-semibold text-gray-700">@item.CreatedDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-[11px] text-gray-500">เวลา @item.CreatedDate.ToString("HH:mm") น.</div>
                                </td>

                                <td class="px-5 py-4 text-center">
                                    @switch (item.Status)
                                    {
                                        case PPMEnergyWeb.Models.QuoteStatus.New:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                                                <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span> มาใหม่
                                            </span>
                                            break;
                                        case PPMEnergyWeb.Models.QuoteStatus.Processing:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-100 text-amber-700">
                                                <i class="fa-solid fa-spinner fa-spin text-[10px]"></i> กำลังดำเนินการ
                                            </span>
                                            break;
                                        case PPMEnergyWeb.Models.QuoteStatus.QuotationSent:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-purple-100 text-purple-700">
                                                <i class="fa-regular fa-paper-plane text-[10px]"></i> ส่งใบเสนอราคาแล้ว
                                            </span>
                                            break;
                                        case PPMEnergyWeb.Models.QuoteStatus.Won:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-green-100 text-green-700">
                                                <i class="fa-solid fa-check text-[10px]"></i> ปิดการขายได้
                                            </span>
                                            break;
                                        case PPMEnergyWeb.Models.QuoteStatus.Lost:
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-red-100 text-red-700">
                                                <i class="fa-solid fa-xmark text-[10px]"></i> ยกเลิก
                                            </span>
                                            break;
                                    }
                                </td>

                                <td class="px-5 py-4 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="w-8 h-8 flex items-center justify-center bg-gray-50 hover:bg-gray-200 text-gray-600 rounded-lg transition-colors shadow-sm" title="ดูรายละเอียด">
                                            <i class="fa-solid fa-eye text-sm"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="w-8 h-8 flex items-center justify-center bg-amber-50 hover:bg-amber-100 text-amber-600 rounded-lg transition-colors shadow-sm" title="แก้ไขราคา">
                                            <i class="fa-solid fa-pen text-sm"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('คุณแน่ใจหรือไม่ที่จะลบรายการนี้?');">
                                            <button type="submit" class="w-8 h-8 flex items-center justify-center bg-red-50 hover:bg-red-100 text-red-600 rounded-lg transition-colors shadow-sm" title="ลบข้อมูล">
                                                <i class="fa-solid fa-trash-can text-sm"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // --- ดึงข้อมูลจริงจาก C# Controller ผ่าน ViewBag ---
        const trendLabels = @Html.Raw(ViewBag.TrendLabels ?? "[]");
        const trendData = @Html.Raw(ViewBag.TrendData ?? "[]");

        const topProductLabels = @Html.Raw(ViewBag.TopProductLabels ?? "[]");
        const topProductData = @Html.Raw(ViewBag.TopProductData ?? "[]");

        // 1. Line Chart: แนวโน้มคำขอ
        const ctxTrend = document.getElementById('trendChart').getContext('2d');
        new Chart(ctxTrend, {
            type: 'line',
            data: {
                labels: trendLabels, // ใช้ข้อมูลจริง
                datasets: [{
                    label: 'จำนวนคำขอ',
                    data: trendData, // ใช้ข้อมูลจริง
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#3b82f6',
                    pointBorderWidth: 2,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { borderDash: [2, 2] }, ticks: { stepSize: 1 } },
                    x: { grid: { display: false } }
                }
            }
        });

        // 2. Bar Chart: Top 5 สินค้ายอดฮิต
        const ctxTop = document.getElementById('topProductsChart').getContext('2d');
        new Chart(ctxTop, {
            type: 'bar',
            data: {
                labels: topProductLabels, // ใช้ข้อมูลจริง
                datasets: [{
                    label: 'จำนวนชิ้น',
                    data: topProductData, // ใช้ข้อมูลจริง
                    backgroundColor: ['#f59e0b', '#10b981', '#3b82f6', '#8b5cf6', '#64748b'],
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y', // กราฟแนวนอน
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { beginAtZero: true, grid: { borderDash: [2, 2] }, ticks: { stepSize: 1 } },
                    y: { grid: { display: false } }
                }
            }
        });
    });
</script>