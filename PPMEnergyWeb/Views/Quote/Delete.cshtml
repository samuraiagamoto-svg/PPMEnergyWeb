@model PPMEnergyWeb.Models.Quote

@{
    ViewData["Title"] = "ลบรายการใบเสนอราคา";
    Layout = "_LayoutAdmin";
}

<div class="max-w-xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl shadow-red-500/5 border border-red-100 overflow-hidden">

        <div class="bg-red-50 px-6 py-6 border-b border-red-100 flex flex-col items-center text-center">
            <div class="w-16 h-16 bg-red-100 text-red-500 rounded-full flex items-center justify-center text-2xl mb-4 shadow-inner">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h2 class="text-xl font-black text-red-700">ยืนยันการลบข้อมูล</h2>
            <p class="text-sm font-medium text-red-500 mt-2">
                คุณแน่ใจหรือไม่ที่ต้องการลบคำขอใบเสนอราคานี้?<br>
                การกระทำนี้ <span class="font-bold underline">ไม่สามารถกู้คืนได้</span>
            </p>
        </div>

        <div class="p-6 bg-white">
            <div class="bg-gray-50 rounded-xl border border-gray-100 p-4 space-y-3">
                <div class="flex justify-between items-center border-b border-gray-200 pb-2">
                    <span class="text-xs font-bold text-gray-500 uppercase">บริษัท</span>
                    <span class="text-sm font-bold text-gray-800">@Model.CompanyName</span>
                </div>
                <div class="flex justify-between items-center border-b border-gray-200 pb-2">
                    <span class="text-xs font-bold text-gray-500 uppercase">ผู้ติดต่อ</span>
                    <span class="text-sm font-semibold text-gray-700">@Model.ContactName</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-gray-500 uppercase">วันที่ขอ</span>
                    <span class="text-sm font-semibold text-gray-700">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>

            <form asp-action="Delete" class="mt-6 flex gap-3">
                <input type="hidden" asp-for="Id" />

                <a asp-action="Index" class="flex-1 text-center py-3 bg-gray-100 hover:bg-gray-200 text-gray-600 rounded-xl font-bold transition-all text-sm">
                    ยกเลิก, กลับไปหน้ารวม
                </a>
                <button type="submit" class="flex-[1.5] py-3 bg-red-500 hover:bg-red-600 text-white rounded-xl font-bold transition-all shadow-lg shadow-red-500/20 text-sm flex items-center justify-center gap-2">
                    <i class="fa-solid fa-trash-can"></i> ลบข้อมูลถาวร
                </button>
            </form>
        </div>
    </div>
</div>