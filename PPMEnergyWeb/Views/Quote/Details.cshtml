@model PPMEnergyWeb.Models.Quote

@{
    ViewData["Title"] = "รายละเอียดใบเสนอราคา";
    Layout = "_LayoutAdmin";
}

<div class="max-w-4xl mx-auto space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
        <div>
            <h2 class="text-xl font-black text-gray-900 flex items-center gap-2">
                <span class="w-1.5 h-5 rounded-md bg-[#009933]"></span>รายละเอียดคำขอ
            </h2>
            <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mt-1">Request Details</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-bold rounded-xl transition-all">
                <i class="fa-solid fa-arrow-left mr-1"></i> กลับหน้ารวม
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="px-4 py-2 bg-blue-50 hover:bg-blue-100 text-blue-600 text-sm font-bold rounded-xl transition-all">
                <i class="fa-solid fa-pen mr-1"></i> แก้ไขราคา
            </a>
            <a asp-action="PrintQuotation" asp-route-id="@Model.Id" target="_blank" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-bold rounded-xl transition-all">
                <i class="fa-solid fa-print mr-1"></i> ดู/พิมพ์ใบเสนอราคา
            </a>
            <form asp-action="SendQuotation" asp-route-id="@Model.Id" method="post" class="inline"
                  onsubmit="return confirm('ยืนยันส่งใบเสนอราคานี้ไปยังอีเมลลูกค้า (@Model.Email) ใช่หรือไม่?');">
                <button type="submit" class="px-4 py-2 bg-[#009933] hover:bg-green-700 text-white text-sm font-bold rounded-xl transition-all shadow-lg shadow-green-500/20">
                    <i class="fa-solid fa-paper-plane mr-1"></i> ส่งให้ลูกค้าทางอีเมล
                </button>
            </form>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="md:col-span-2 space-y-6">

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-sm font-bold text-gray-800 mb-4 flex items-center gap-2 border-b border-gray-50 pb-3">
                    <i class="fa-solid fa-address-card text-[#009933]"></i> ข้อมูลผู้ติดต่อ
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-6">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">ชื่อบริษัท / องค์กร</label>
                        <p class="text-sm font-bold text-gray-800">@Model.CompanyName</p>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">ชื่อผู้ติดต่อ</label>
                        <p class="text-sm font-semibold text-gray-700">@Model.ContactName</p>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">อีเมล</label>
                        <a href="mailto:@Model.Email" class="text-sm font-semibold text-blue-600 hover:underline">@Model.Email</a>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">เบอร์โทรศัพท์</label>
                        <a href="tel:@Model.Phone" class="text-sm font-semibold text-gray-700 hover:text-blue-600">@Model.Phone</a>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-sm font-bold text-gray-800 mb-4 flex items-center gap-2 border-b border-gray-50 pb-3">
                    <i class="fa-solid fa-map-location-dot text-[#009933]"></i> รายละเอียดการจัดส่ง
                </h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">สถานที่จัดส่งปลายทาง</label>
                        <div class="flex items-start gap-2 bg-gray-50 p-3 rounded-xl border border-gray-100">
                            <i class="fa-solid fa-location-dot text-red-500 mt-0.5"></i>
                            <p class="text-sm font-semibold text-gray-700">@(string.IsNullOrEmpty(Model.DeliveryLocation) ? "-" : Model.DeliveryLocation)</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <div>
                            <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">หมายเหตุเพิ่มเติม</label>
                            <div class="bg-amber-50 text-amber-800 p-3 rounded-xl border border-amber-100 text-sm italic">
                                @Model.Note
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="space-y-6">

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-sm font-bold text-gray-800 mb-4 flex items-center gap-2 border-b border-gray-50 pb-3">
                    <i class="fa-solid fa-clipboard-list text-[#009933]"></i> สถานะคำขอ
                </h3>
                <div class="space-y-4 text-center">
                    <div>
                        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2">สถานะปัจจุบัน</p>
                        @switch (Model.Status)
                        {
                            case PPMEnergyWeb.Models.QuoteStatus.New:
                                <span class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-bold bg-blue-50 text-blue-600 w-full">
                                    <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span> รอการตรวจสอบ
                                </span>
                                break;
                            case PPMEnergyWeb.Models.QuoteStatus.Processing:
                                <span class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-bold bg-amber-50 text-amber-600 w-full">
                                    <i class="fa-solid fa-spinner fa-spin"></i> กำลังทำราคา
                                </span>
                                break;
                            case PPMEnergyWeb.Models.QuoteStatus.QuotationSent:
                                <span class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-bold bg-indigo-50 text-indigo-600 w-full">
                                    <i class="fa-solid fa-paper-plane"></i> ส่งเสนอราคาแล้ว
                                </span>
                                break;
                            case PPMEnergyWeb.Models.QuoteStatus.Won:
                                <span class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-bold bg-green-50 text-green-600 w-full">
                                    <i class="fa-solid fa-check-circle"></i> ปิดการขายสำเร็จ
                                </span>
                                break;
                            case PPMEnergyWeb.Models.QuoteStatus.Lost:
                                <span class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-bold bg-red-50 text-red-600 w-full">
                                    <i class="fa-solid fa-xmark-circle"></i> ยกเลิก/ไม่สำเร็จ
                                </span>
                                break;
                        }
                    </div>
                    <div class="pt-2">
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">วันที่ส่งคำขอ</label>
                        <p class="text-sm font-bold text-gray-700">@Model.CreatedDate.ToString("dd MMM yyyy, HH:mm น.")</p>
                    </div>
                    <div class="pt-2">
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">ผู้ขาย (พนักงานที่ดูแล)</label>
                        <p class="text-sm font-bold text-gray-700">@(string.IsNullOrEmpty(Model.SalesPersonName) ? "ยังไม่ระบุ" : Model.SalesPersonName)</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-sm font-bold text-gray-800 mb-4 flex items-center gap-2 border-b border-gray-50 pb-3">
                    <i class="fa-solid fa-box-open text-[#009933]"></i> สินค้าที่สนใจ
                </h3>

                @if (Model.QuoteDetails != null && Model.QuoteDetails.Any())
                {
                    <ul class="space-y-3">
                        @foreach (var detail in Model.QuoteDetails)
                        {
                            <li class="p-3 bg-gray-50 rounded-xl border border-gray-100">
                                <p class="text-sm font-bold text-gray-800 line-clamp-2" title="@detail.ProductName">@detail.ProductName</p>
                                <div class="mt-2 flex items-center justify-between">
                                    <span class="text-[11px] font-bold text-gray-400">จำนวนที่ต้องการ:</span>
                                    <span class="text-sm font-black text-[#009933] bg-green-50 px-2 py-0.5 rounded">@detail.Quantity ชิ้น</span>
                                </div>
                                <div class="mt-1 flex items-center justify-between">
                                    <span class="text-[11px] font-bold text-gray-400">ราคา/หน่วย:</span>
                                    @if (detail.Price > 0)
                                    {
                                        <span class="text-sm font-black text-gray-700">@detail.Price.ToString("N2") บาท</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs font-bold text-amber-600 italic">ยังไม่ได้ตั้งราคา</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-sm text-gray-400 italic text-center py-4">ไม่พบข้อมูลสินค้า</p>
                }
            </div>

        </div>
    </div>
</div>