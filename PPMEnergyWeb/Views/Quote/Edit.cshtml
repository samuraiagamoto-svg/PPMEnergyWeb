@model PPMEnergyWeb.Models.Quote

@{
    ViewData["Title"] = "อัปเดตสถานะคำขอ";
    Layout = "_LayoutAdmin";
}

<div class="max-w-2xl mx-auto space-y-6">

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">

        <div class="bg-gray-50 px-6 py-5 border-b border-gray-100 flex items-center justify-between">
            <div>
                <h2 class="text-xl font-black text-gray-900 flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-[#009933]"></i> อัปเดตสถานะงาน
                </h2>
                <p class="text-xs text-gray-500 mt-1">บริษัท: <span class="font-bold text-gray-700">@Model.CompanyName</span></p>
            </div>
            <a asp-action="Index" class="w-8 h-8 flex items-center justify-center rounded-full bg-white hover:bg-gray-100 text-gray-400 hover:text-gray-600 shadow-sm transition-all border border-gray-200">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </div>

        <div class="p-6">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CompanyName" />
                <input type="hidden" asp-for="ContactName" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Phone" />
                <input type="hidden" asp-for="DeliveryLocation" />
                <input type="hidden" asp-for="Note" />
                <input type="hidden" asp-for="CreatedDate" />
                <input type="hidden" asp-for="UserId" />

                <div class="mb-6">
                    <label asp-for="SalesPersonName" class="block text-sm font-bold text-gray-700 mb-2">ชื่อผู้ขาย (แสดงในใบเสนอราคา)</label>
                    <div class="relative">
                        <i class="fa-solid fa-user-tie absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input asp-for="SalesPersonName" placeholder="ชื่อพนักงานขาย"
                               class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none font-semibold text-gray-800" />
                    </div>
                </div>

                <div class="mb-6">
                    <label asp-for="Status" class="block text-sm font-bold text-gray-700 mb-2">เลือกสถานะปัจจุบันของงานนี้</label>
                    <div class="relative">
                        <i class="fa-solid fa-list-check absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<PPMEnergyWeb.Models.QuoteStatus>()"
                                class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none font-semibold text-gray-800 appearance-none cursor-pointer">
                        </select>
                        <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none"></i>
                    </div>
                    <span asp-validation-for="Status" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-bold text-gray-700 mb-2">ราคาต่อหน่วยของแต่ละรายการ</label>
                    <div class="border border-gray-200 rounded-xl overflow-hidden">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="bg-gray-50 text-gray-500 text-xs uppercase">
                                    <th class="px-4 py-2 text-left">รายการ</th>
                                    <th class="px-4 py-2 text-right">จำนวน</th>
                                    <th class="px-4 py-2 text-right w-36">ราคา/หน่วย (บาท)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.QuoteDetails.Count; i++)
                                {
                                    <tr class="border-t border-gray-100">
                                        <td class="px-4 py-2 font-semibold text-gray-700">
                                            @Model.QuoteDetails[i].ProductName
                                            <input type="hidden" name="detailId" value="@Model.QuoteDetails[i].Id" />
                                        </td>
                                        <td class="px-4 py-2 text-right text-gray-600">@Model.QuoteDetails[i].Quantity.ToString("N0")</td>
                                        <td class="px-4 py-2">
                                            <input type="number" step="0.01" min="0" name="detailPrice"
                                                   value="@Model.QuoteDetails[i].Price"
                                                   class="w-full text-right px-2 py-1.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#009933]/20 focus:border-[#009933] outline-none font-semibold text-gray-800" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 mb-6 flex gap-3 text-blue-800">
                    <i class="fa-solid fa-circle-info mt-0.5"></i>
                    <p class="text-xs font-medium leading-relaxed">
                        กรอกราคาแล้วกด "บันทึกการเปลี่ยนแปลง" ก่อน จากนั้นไปที่หน้ารายละเอียดเพื่อกด "ส่งใบเสนอราคาให้ลูกค้าทางอีเมล"
                    </p>
                </div>

                <div class="flex gap-3 pt-4 border-t border-gray-100">
                    <a asp-action="Index" class="flex-1 text-center py-3 bg-gray-100 hover:bg-gray-200 text-gray-600 rounded-xl font-bold transition-all text-sm">
                        ยกเลิก
                    </a>
                    <button type="submit" class="flex-[2] py-3 bg-[#009933] hover:bg-green-700 text-white rounded-xl font-bold transition-all shadow-lg shadow-green-500/20 text-sm flex items-center justify-center gap-2">
                        <i class="fa-solid fa-save"></i> บันทึกการเปลี่ยนแปลง
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}