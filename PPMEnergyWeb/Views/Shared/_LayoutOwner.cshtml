@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PPM Owner</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="icon" type="image/png" href="~/images/ppmlogo.png" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ppmgreen: { DEFAULT: '#0a8f08', dark: '#087506' }
                    }
                }
            }
        }
    </script>

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Sarabun', sans-serif; }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            color: #94a3b8;
            transition: all 0.2s;
            text-decoration: none;
        }
        .sidebar-link:hover {
            background: rgba(10, 143, 8, 0.1);
            color: #0a8f08;
        }
        .sidebar-link.active {
            background: rgba(10, 143, 8, 0.15);
            color: #0a8f08;
        }
        .sidebar-link .icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(10, 143, 8, 0.08);
            flex-shrink: 0;
            font-size: 14px;
        }
        .sidebar-link:hover .icon,
        .sidebar-link.active .icon {
            background: rgba(10, 143, 8, 0.2);
        }
    </style>
</head>
<body class="bg-gray-50 flex h-screen overflow-hidden">

    @{
        var currentAction     = ViewContext.RouteData.Values["Action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    }

    <!-- ── Sidebar ──────────────────────────────────────────── -->
    <aside class="w-64 bg-[#0f172a] flex flex-col h-full flex-shrink-0">

        <!-- Logo -->
        <div class="px-6 py-5 border-b border-white/5">
            <div class="flex items-center gap-3">
                <img src="~/images/ppmlogo.png" class="h-9 w-9 rounded-xl object-cover" alt="PPM"
                     onerror="this.src='https://ui-avatars.com/api/?name=PPM&background=0a8f08&color=fff'" />
                <div>
                    <p class="text-white font-black text-sm leading-none">PPM ENERGY</p>
                    <p class="text-ppmgreen text-[10px] font-bold tracking-widest uppercase mt-0.5">Owner Portal</p>
                </div>
            </div>
        </div>

        <!-- User Info -->
        <div class="px-4 py-4 border-b border-white/5">
            <div class="flex items-center gap-3 bg-white/5 rounded-xl px-3 py-2.5">
                <div class="w-8 h-8 rounded-full bg-ppmgreen flex items-center justify-center text-white text-xs font-black uppercase flex-shrink-0">
                    @(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "O")
                </div>
                <div class="overflow-hidden">
                    <p class="text-white text-xs font-bold truncate">@User.Identity?.Name</p>
                    <p class="text-ppmgreen text-[10px] font-bold uppercase tracking-wider">เจ้าของ</p>
                </div>
            </div>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest px-3 mb-2">รายงาน</p>

            <a asp-controller="OwnerReport" asp-action="Index"
               class="sidebar-link @(currentAction == "Index" ? "active" : "")">
                <div class="icon"><i class="fa-solid fa-chart-pie"></i></div>
                Dashboard
            </a>

            <a asp-controller="OwnerReport" asp-action="Customers"
               class="sidebar-link @(currentAction == "Customers" ? "active" : "")">
                <div class="icon"><i class="fa-solid fa-users"></i></div>
                รายงานลูกค้า
            </a>

            <a asp-controller="OwnerReport" asp-action="Quotes"
               class="sidebar-link @(currentAction == "Quotes" ? "active" : "")">
                <div class="icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                รายงานใบเสนอราคา
            </a>

            <div class="pt-4 mt-4 border-t border-white/5">
                <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest px-3 mb-2">ลิงก์</p>

                <a href="/" class="sidebar-link">
                    <div class="icon"><i class="fa-solid fa-globe"></i></div>
                    ดูหน้าเว็บไซต์
                </a>
            </div>
        </nav>

        <!-- Logout -->
        <div class="px-3 py-4 border-t border-white/5">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit"
                        class="sidebar-link w-full text-red-400 hover:bg-red-500/10 hover:text-red-400">
                    <div class="icon" style="background:rgba(239,68,68,0.1);">
                        <i class="fa-solid fa-power-off text-red-400"></i>
                    </div>
                    ออกจากระบบ
                </button>
            </form>
        </div>
    </aside>

    <!-- ── Main Content ──────────────────────────────────────── -->
    <div class="flex-1 flex flex-col overflow-hidden">

        <!-- Top Bar -->
        <header class="bg-white border-b border-gray-100 px-8 py-4 flex items-center justify-between flex-shrink-0">
            <div>
                <h2 class="text-lg font-black text-gray-900">@ViewData["Title"]</h2>
                <p class="text-xs text-gray-400 font-semibold">
                    <i class="fa-regular fa-calendar mr-1"></i>
                    @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("th-TH"))
                </p>
            </div>
            <div class="flex items-center gap-3">
                <a href="/" target="_blank"
                   class="flex items-center gap-2 text-xs font-bold text-gray-400 hover:text-ppmgreen transition-colors px-3 py-2 rounded-lg hover:bg-ppmgreen/5">
                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                    หน้าเว็บไซต์
                </a>
            </div>
        </header>

        <!-- Page Content -->
        <main class="flex-1 overflow-y-auto p-8">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
