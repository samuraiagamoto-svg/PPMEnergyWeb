@model PPMEnergyWeb.Models.Product

@{
    ViewData["Title"] = "เพิ่มสินค้าใหม่";
    Layout = "_LayoutAdmin";
}

<div class="space-y-6 max-w-6xl mx-auto">
    <div class="flex items-center justify-between">
        <a asp-action="Index" class="inline-flex items-center text-sm font-semibold text-gray-500 hover:text-ppmgreen transition-colors">
            <i class="fa-solid fa-arrow-left mr-2 text-xs"></i> ย้อนกลับไปรายการสินค้า
        </a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        @Html.AntiForgeryToken()

        @* ซ้าย: ข้อมูลหลัก *@
        <div class="lg:col-span-2 bg-white border border-gray-200/80 shadow-sm rounded-2xl p-6 space-y-5">
            <div class="border-b border-gray-100 pb-4">
                <h2 class="text-lg font-bold text-gray-900">รายละเอียดสินค้าใหม่</h2>
                <p class="text-xs text-gray-500">กรุณากรอกข้อมูลสินค้าให้ครบถ้วน</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="p-4 bg-red-50 border border-red-200 rounded-xl text-xs text-red-700 flex items-start space-x-2">
                    <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
                    <div asp-validation-summary="All" class="font-medium"></div>
                </div>
            }

            <div class="space-y-1.5">
                <label asp-for="Name" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">ชื่อสินค้า</label>
                <input asp-for="Name" class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none transition-all font-semibold text-gray-800" placeholder="ระบุชื่อสินค้า" required />
                <span asp-validation-for="Name" class="text-xs font-semibold text-red-500"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="Description" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">คำอธิบาย/สรุปสั้นๆ</label>
                <textarea asp-for="Description" rows="2" class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none transition-all text-gray-700" placeholder="สรุปจุดเด่น 1-2 บรรทัด..."></textarea>
            </div>

            <div class="space-y-1.5">
                <label asp-for="FullContent" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">รายละเอียดเชิงลึก</label>
                <textarea asp-for="FullContent" rows="5" class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none transition-all text-gray-700" placeholder="ข้อมูลทางเทคนิค หรือรายละเอียดการรับประกัน..."></textarea>
            </div>

            <div class="space-y-1.5">
                <label asp-for="GeneralFeatures" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">คุณสมบัติเด่น (คั่นด้วย |)</label>
                <textarea asp-for="GeneralFeatures" rows="3" class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none transition-all text-gray-700" placeholder="เช่น ทนความร้อนสูง | มาตรฐานสากล | ISO 9001"></textarea>
                <p class="text-[10px] text-gray-400">คั่นแต่ละคุณสมบัติด้วย | เช่น "ทนความร้อน | ทนสึกหรอ"</p>
            </div>

            @* ตารางสเปค (Attributes) *@
            <div class="space-y-3 border-t border-gray-100 pt-5">
                <div class="flex items-center justify-between">
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
                        ตารางสเปค / ข้อมูลทางเทคนิค
                    </label>
                    <button type="button" onclick="addAttributeRow()"
                            class="inline-flex items-center px-3 py-1.5 bg-ppmgreen/10 text-ppmgreen text-xs font-bold rounded-lg hover:bg-ppmgreen/20 transition-colors">
                        <i class="fa-solid fa-plus mr-1.5 text-[10px]"></i> เพิ่มแถว
                    </button>
                </div>
                <div id="attributesContainer" class="space-y-2">
                    @if (Model.Attributes != null && Model.Attributes.Any())
                    {
                        @for (int i = 0; i < Model.Attributes.Count; i++)
                        {
                            <div class="flex gap-2 items-center attr-row">
                                <input type="text" name="Attributes[@i].AttributeName"
                                       value="@Model.Attributes.ElementAt(i).AttributeName"
                                       placeholder="หัวข้อ เช่น DIN, C, Hardness"
                                       class="flex-1 px-3 py-2 bg-white border border-gray-200 rounded-lg text-xs font-semibold focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none" />
                                <input type="text" name="Attributes[@i].AttributeValue"
                                       value="@Model.Attributes.ElementAt(i).AttributeValue"
                                       placeholder="ค่า เช่น X155CrVMo 12-1"
                                       class="flex-1 px-3 py-2 bg-white border border-gray-200 rounded-lg text-xs focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none" />
                                <button type="button" onclick="this.closest('.attr-row').remove()"
                                        class="w-8 h-8 flex items-center justify-center text-red-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors shrink-0">
                                    <i class="fa-solid fa-xmark text-xs"></i>
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        @* ขวา: หมวดหมู่ + รูป + ปุ่ม *@
        <div class="space-y-6">
            <div class="bg-white border border-gray-200/80 shadow-sm rounded-2xl p-6 space-y-4">
                <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider border-b border-gray-100 pb-2">การจัดกลุ่มสินค้า</h3>
                <div class="space-y-1.5">
                    <label asp-for="CategoryId" class="block text-xs font-semibold text-gray-600">เลือกหมวดหมู่สินค้า</label>
                    <div class="relative">
                        <select asp-for="CategoryId" id="categorySelect"
                                class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-bold text-gray-800 focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none transition-all appearance-none cursor-pointer" required>
                            <option value="">-- กรุณาเลือกหมวดหมู่ --</option>
                            @foreach (var grp in (ViewBag.CategoryId as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new())
                                .GroupBy(x => x.Group?.Name))
                            {
                                if (grp.Key != null)
                                {
                                    <optgroup label="@grp.Key">
                                        @foreach (var item in grp)
                                        {
                                            <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">
                                                &nbsp;&nbsp;@item.Text
                                            </option>
                                        }
                                    </optgroup>
                                }
                                else
                                {
                                    @foreach (var item in grp)
                                    {
                                        <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">
                                            @item.Text
                                        </option>
                                    }
                                }
                            }
                        </select>
                        <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-gray-400 text-xs">
                            <i class="fa-solid fa-chevron-down"></i>
                        </div>
                    </div>
                    <span asp-validation-for="CategoryId" class="text-xs font-semibold text-red-500"></span>
                </div>
            </div>

            <div class="bg-white border border-gray-200/80 shadow-sm rounded-2xl p-6 space-y-4">
                <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider border-b border-gray-100 pb-2">ภาพสินค้า</h3>
                <div class="space-y-3">
                    <label asp-for="ImageFile" class="block text-xs font-semibold text-gray-600">อัปโหลดรูปภาพหลัก</label>
                    <input asp-for="ImageFile" type="file" accept="image/*"
                           class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-ppmgreen/10 file:text-ppmgreen hover:file:bg-ppmgreen/20 cursor-pointer" />
                </div>
            </div>

            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4 flex items-center justify-between space-x-3">
                <a asp-action="Index" class="w-1/2 text-center px-4 py-2.5 border border-gray-200 text-gray-700 hover:bg-gray-100 text-sm font-semibold rounded-xl transition-colors">
                    ยกเลิก
                </a>
                <button type="submit" class="w-1/2 px-5 py-2.5 bg-ppmgreen text-white hover:bg-ppmgreen-dark text-sm font-bold rounded-xl transition-colors shadow-sm shadow-ppmgreen/10 flex items-center justify-center">
                    <i class="fa-solid fa-floppy-disk mr-2"></i> บันทึกสินค้า
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        let attrIndex = document.querySelectorAll('.attr-row').length;

        function addAttributeRow() {
            const container = document.getElementById('attributesContainer');
            const row = document.createElement('div');
            row.className = 'flex gap-2 items-center attr-row';
            row.innerHTML = `
                <input type="text" name="Attributes[${attrIndex}].AttributeName"
                       placeholder="หัวข้อ เช่น DIN, C, Hardness"
                       class="flex-1 px-3 py-2 bg-white border border-gray-200 rounded-lg text-xs font-semibold focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none" />
                <input type="text" name="Attributes[${attrIndex}].AttributeValue"
                       placeholder="ค่า เช่น X155CrVMo 12-1"
                       class="flex-1 px-3 py-2 bg-white border border-gray-200 rounded-lg text-xs focus:ring-2 focus:ring-ppmgreen/20 focus:border-ppmgreen outline-none" />
                <button type="button" onclick="this.closest('.attr-row').remove()"
                        class="w-8 h-8 flex items-center justify-center text-red-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors shrink-0">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>`;
            container.appendChild(row);
            attrIndex++;
        }
    </script>
}
